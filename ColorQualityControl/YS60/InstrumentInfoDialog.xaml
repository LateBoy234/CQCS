<Window x:Class="ThreeNH.ColorQualityControl.YS60.InstrumentInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cqc="clr-namespace:ThreeNH.ColorQualityControl"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="{StaticResource Title_InstrumentStatus}">
    <Window.Resources>
        <cqc:CalibrationConverter x:Key="_calibrationConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="5" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="5" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="MinWidth" Value="120" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource Label_InstrumentModelColon}" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Path=DeviceInfo.Model, Mode=OneWay}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource Label_SNColon}" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Path=DeviceInfo.Sn, Mode=OneWay}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{StaticResource Label_OpticalStructColon}" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Path=DeviceInfo.Optical, Mode=OneWay}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{StaticResource Label_HardwareVersionColon}" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Path=DeviceInfo.HardwareVersion, Mode=OneWay}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="{StaticResource Label_FirmwareVersionColon}" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Path=DeviceInfo.SoftwareVersion, Mode=OneWay}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="{StaticResource Label_WhiteBoardNumberColon}" />
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Path=DeviceInfo.WhiteBoardNumber, Mode=OneWay}" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="{StaticResource Label_BlackBucketNumberColon}" />
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Path=DeviceInfo.BlackBucketNumber, Mode=OneWay}" />

        <TextBlock Grid.Row="7" Grid.Column="0" Text="{StaticResource Label_CalibrationColon}" />
        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Path=Status.IsCalibrated, Mode=OneWay,
            Converter={StaticResource _calibrationConverter}}" />

        <TextBlock Grid.Row="8" Grid.Column="0" Text="{StaticResource Label_StandardCapacityColon}" />
        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Path=DeviceInfo.StandardCapacity, Mode=OneWay}" />

        <TextBlock Grid.Row="9" Grid.Column="0" Text="{StaticResource Label_StandardCountColon}" />
        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Path=Status.StandardCount, Mode=OneWay}" />

        <TextBlock Grid.Row="10" Grid.Column="0" Text="{StaticResource Label_SampleCapacityColon}" />
        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Path=DeviceInfo.TrialCapacity, Mode=OneWay}" />

        <TextBlock Grid.Row="11" Grid.Column="0" Text="{StaticResource Label_TestCountColon}" />
        <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Path=Status.TrialCount, Mode=OneWay}" />

    </Grid>
</Window>
