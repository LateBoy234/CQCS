<Window x:Class="ThreeNH.ColorQualityControl.YRColorimeter.YRGetSamplingDataDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="Width"
        FontSize="12"
        Title="YR 原始值测量" MinWidth="300" MinHeight="400">
    <Window.Resources>
        <Style x:Key="btnStyle" TargetType="Button">
            <Setter Property="Margin" Value="5" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style x:Key="lableStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="editStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0, 5, 5, 5" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <DataGrid Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  ItemsSource="{Binding Path=SamplingDataList}"
                  LoadingRow="DataGrid_LoadingRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="主灯亮-X" Binding="{Binding Path=MajorLightOn[0]}" />
                <DataGridTextColumn Header="主灯亮-Y" Binding="{Binding Path=MajorLightOn[1]}"/>
                <DataGridTextColumn Header="主灯亮-Z" Binding="{Binding Path=MajorLightOn[2]}"/>
                <DataGridTextColumn Header="辅灯亮-X" Binding="{Binding Path=MinorLightOn[0]}"/>
                <DataGridTextColumn Header="辅灯亮-Y" Binding="{Binding Path=MinorLightOn[1]}"/>
                <DataGridTextColumn Header="辅灯亮-Z" Binding="{Binding Path=MinorLightOn[2]}"/>

                <DataGridTextColumn Header="主灯灭-X" Binding="{Binding Path=MajorLightOff[0]}" />
                <DataGridTextColumn Header="主灯灭-Y" Binding="{Binding Path=MajorLightOff[1]}" />
                <DataGridTextColumn Header="主灯灭-Z" Binding="{Binding Path=MajorLightOff[2]}" />
                <DataGridTextColumn Header="辅灯灭-X" Binding="{Binding Path=MinorLightOff[0]}" />
                <DataGridTextColumn Header="辅灯灭-Y" Binding="{Binding Path=MinorLightOff[1]}" />
                <DataGridTextColumn Header="辅灯灭-Z" Binding="{Binding Path=MinorLightOff[2]}" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource lableStyle}" >测量次数：</TextBlock>
            <TextBox Grid.Column="1" Style="{StaticResource editStyle}" Text="{Binding Times}" />
            <TextBlock Grid.Column="2" Margin="24, 5, 5, 5" Style="{StaticResource lableStyle}" >测量间隔：</TextBlock>
            <TextBox Grid.Column="3" Style="{StaticResource editStyle}" Text="{Binding Interval}" />
            <Button Grid.Column="4" Style="{StaticResource btnStyle}" HorizontalAlignment="Center"
                    Name="measureBtn"
                    Content="测量" Click="BtnMeasure_Click" />
            <Button Grid.Column="5" Style="{StaticResource btnStyle}" HorizontalAlignment="Center"
                    Content="清空" Click="ClearBtn_Click"/>

            <Button Grid.Column="6" Style="{StaticResource btnStyle}" Content="导出"
                    Click="BtnExport_Click"/>
        </Grid>
    </Grid>
</Window>
