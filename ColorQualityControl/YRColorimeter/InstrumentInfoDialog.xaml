<Window x:Class="ThreeNH.ColorQualityControl.YRColorimeter.InstrumentInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:main="clr-namespace:ThreeNH.ColorQualityControl"
        WindowStartupLocation="CenterScreen"
        Title="{StaticResource Title_InstrumentStatus}"
        SizeToContent="WidthAndHeight">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <main:CalibrationConverter x:Key="CalibrationConverter" />
    </Window.Resources>
    <Grid Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="150" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_ConnectionStatusColon}" />
        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueStyle}"
                   Text="{Binding Connection}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_InstrumentModelColon}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueStyle}"
                   Text="{Binding DeviceInfo.CustomModel}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_OpticalStructColon}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueStyle}"
                   Text="{Binding DeviceInfo.OpticalStruct}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_SNColon}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueStyle}"
                   Text="{Binding DeviceInfo.Sn}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_HardwareVersionColon}" />
        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueStyle}"
                   Text="{Binding DeviceInfo.HardwareVersion}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_SoftwareVersionColon}" />
        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueStyle}"
                   Text="{Binding DeviceInfo.FirmwareVersion}" />

        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_WhiteBoardNumberColon}" />
        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource ValueStyle}"
                   Text="{Binding DeviceInfo.ExternalSnOfWhiteBoard}" />

        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_BlackCalibrationColon}" />
        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource ValueStyle}"
                   Text="{Binding DeviceInfo.IsBlackCalibrated, Converter={StaticResource CalibrationConverter}}" />

        <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_WhiteCalibrationColon}" />
        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource ValueStyle}"
                   Text="{Binding DeviceInfo.IsWhiteCalibrated, Converter={StaticResource CalibrationConverter}}" />

        <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_CapacityColon}" />
        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource ValueStyle}"
                   Text="{Binding DeviceInfo.Capacity}" />

        <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_StandardCountColon}" />
        <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource ValueStyle}"
                   Text="{Binding DeviceInfo.StandardCount}" />

        <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_TestCountColon}" />
        <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource ValueStyle}"
                   Text="{Binding DeviceInfo.TestCount}" />

        <Button Grid.Row="12" Grid.Column="1" IsCancel="True" Margin="6,6,3,3"
                HorizontalAlignment="Right" MinWidth="60"
                Content="{StaticResource Label_Close}" />
    </Grid>
</Window>
