<Window x:Class="ThreeNH.ColorQualityControl.ConnectionSettingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl"
        xmlns:converters="clr-namespace:ThreeNH.ColorQualityControl.Converters"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="连接设置" SizeToContent="WidthAndHeight">
    <Window.Resources>
        <converters:BoolEquationConverter x:Key="BoolEquationConverter" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="仪器型号" Margin="5">
            <StackPanel>
                <RadioButton x:Name="RadioButtonTnh" 
                             FontSize="16"
                             Margin="5"
                             Content="三恩时"
                             IsChecked="{Binding InstrumentCatalog, Converter={StaticResource BoolEquationConverter}, ConverterParameter=Tnh}"/>
                <RadioButton x:Name="RadioButtonCr400"
                             FontSize="16"
                             Margin="5"
                             Content="CR400"
                             IsChecked="{Binding InstrumentCatalog, Converter={StaticResource BoolEquationConverter}, ConverterParameter=CR400}"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="0" Grid.Column="1" Header="连接配置" Margin="5"
                  IsEnabled="{Binding ElementName=RadioButtonCr400, Path=IsChecked}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormTextBlockStyle}" 
                           Text="串口："/>
                <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormComboBoxStyle}" 
                          ItemsSource="{Binding PortNames}"
                          SelectedItem="{Binding PortName}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormTextBlockStyle}"
                           Text="波特率："/>
                <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormComboBoxStyle}"
                          ItemsSource="{Binding BaudRates}"
                          SelectedItem="{Binding BaudRate}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FormTextBlockStyle}" 
                           Text="校验：" />
                <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormComboBoxStyle}"
                          ItemsSource="{Binding Parities}"
                          SelectedItem="{Binding Parity}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FormTextBlockStyle}"
                           Text="停止位" />
                <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormComboBoxStyle}"
                          ItemsSource="{Binding StopBitsItems}" 
                          SelectedItem="{Binding StopBits}"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="确定" Margin="10" FontSize="24" MinWidth="72" IsDefault="True"
                    Click="OnOkClick"/>
            <Button Content="取消" Margin="10" FontSize="24" MinWidth="72" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
