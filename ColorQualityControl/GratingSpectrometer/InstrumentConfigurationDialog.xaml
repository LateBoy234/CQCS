<Window x:Class="ThreeNH.GratingSpectrometer.InstrumentConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThreeNH.GratingSpectrometer"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Title="仪器配置">
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <TabControl Grid.Row="0" 
                    Name="tabControl"
                    SelectionChanged="OnTabControlSelectionChanged">
            <TabItem Header="测量参数">
                <local:MeasurementParameterControl x:Name="MeasurementParameterControl" />
            </TabItem>
            <TabItem Header="色彩选项">
                <local:ChromaticityOperationsControl x:Name="ChromaticityOperationControl" />
            </TabItem>
            <TabItem Header="白板参数">
                <local:WhiteBoardParameterControl x:Name="WhiteBoardParameterControl" />
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="60" Margin="6" Click="OnOkClick">确定</Button>
            <Button MinWidth="60" Margin="6" IsCancel="True">取消</Button>
            <Button MinWidth="60" Margin="6" IsDefault="True" Click="OnAcceptClick">套用</Button>
        </StackPanel>
    </Grid>
</Window>
