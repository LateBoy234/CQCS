<UserControl x:Class="ThreeNH.GratingSpectrometer.ChromaticityOperationsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ThreeNH.GratingSpectrometer"
             >
    <UserControl.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="3" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Margin="6" Grid.Column="0" Header="颜色空间">
                <ComboBox Margin="6" Name="colorSpaceComboBox" SelectionChanged="OnColorSpaceSelectionChanged" />
            </GroupBox>
            <GroupBox Margin="6" Grid.Column="1" Header="色差公式">
                <ComboBox Margin="6" Name="colorDiffFormulaComboBox" SelectionChanged="OnColorDiffFormulaSelectionChanged" />
            </GroupBox>
        </Grid>
        <GroupBox Margin="6" Header="容差">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">下限：</TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">上限：</TextBlock>

                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource LabelStyle}">&#x0394;L*</TextBlock>
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueStyle}"
                         Text="{Binding Path=ChromaticityOperations.Tolerance.dL_Lower, StringFormat=F3}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueStyle}"
                         Text="{Binding Path=ChromaticityOperations.Tolerance.dL_Upper, StringFormat=F3}"/>
                
                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}">&#x0394;a*</TextBlock>
                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueStyle}"
                         Text="{Binding Path=ChromaticityOperations.Tolerance.da_Lower, StringFormat=F3}"/>
                <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueStyle}"
                         Text="{Binding Path=ChromaticityOperations.Tolerance.da_Upper, StringFormat=F3}"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource LabelStyle}">&#x0394;b*</TextBlock>
                <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource ValueStyle}"
                         Text="{Binding Path=ChromaticityOperations.Tolerance.db_Lower, StringFormat=F3}"/>
                <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource ValueStyle}"
                         Text="{Binding Path=ChromaticityOperations.Tolerance.db_Upper, StringFormat=F3}"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource LabelStyle}">&#x0394;E*</TextBlock>
                <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource ValueStyle}"
                         Text="{Binding Path=ChromaticityOperations.Tolerance.dE, StringFormat=F3}"/>
            </Grid>
        </GroupBox>
    </StackPanel>
</UserControl>
