<UserControl x:Class="ThreeNH.ColorQualityControl.Agent.ChatInputBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.Agent"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="RoundBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource RoundBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="7*"/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>

            <!-- 多行输入框 + 占位提示 -->
            <TextBox x:Name="InputTextBox" Grid.Row="0" Margin="16,16,16,0"
                     VerticalAlignment="Top"
                     AcceptsReturn="False"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="16"
                     Foreground="#111111" MinHeight="90">
                <TextBox.Resources>
                    <Style TargetType="TextBox">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <!-- 底部栏：左 + 右 -->
            <Grid Grid.Row="1" Margin="12,0,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions  >
                <!-- 发送 / 中断 双态按钮：空闲显示发送箭头，发送中显示方块（中断） -->
                <Button x:Name="BtnSend" 
        Width="37" 
        Height="37" 
        HorizontalAlignment="Right" 
        Margin="0 5 10 5" 
        ToolTip="发送" >
                    <Button.Clip>
                        <EllipseGeometry RadiusX="17" RadiusY="17" Center="19,19.5"/>
                    </Button.Clip>
                    <Grid Width="37" Height="37">
                        <!-- 发送箭头 -->
                        <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="SendIcon" 
              Data="M2.01,21L23,12 2.01,3 2,10l15,2 -15,2z" 
              Fill="#555"
              Stretch="Uniform"
                              Width="18" Height=" 18"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
                        </Grid>
                        <!-- 停止方块 -->
                        <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="StopIcon"  Visibility="Collapsed"
                  Data="M7,7 H29 V29 H7 Z" 
                  Fill="#E53935" 
                  Stretch="Uniform"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="-2,-2,0,0"/>
                        </Grid>
                    </Grid>
                </Button>

            </Grid>
        </Grid>
    </Border>
</UserControl>