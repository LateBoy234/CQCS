<UserControl
    x:Class="ThreeNH.Controls.ColorValueInputControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ThreeNH.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Name="Label1"
            Grid.Column="0"
            Margin="3"
            VerticalAlignment="Center"
            Text="L*:" />
        <TextBox
            Name="txt1"
            Grid.Column="1"
            MinWidth="60"
            MaxWidth="150"
            Margin="3"
            VerticalAlignment="Center"
            KeyDown="KeyDown"
            Text="{Binding Path=Value1, StringFormat=F4}" />

        <TextBlock
            Name="Label2"
            Grid.Column="2"
            Margin="3"
            VerticalAlignment="Center"
            Text="a*:" />
        <TextBox
            Name="txt2"
            Grid.Column="3"
            MinWidth="60"
            MaxWidth="150"
            Margin="3"
            VerticalAlignment="Center"
            KeyDown="KeyDown"
            Text="{Binding Path=Value2, StringFormat=F4}" />

        <TextBlock
            Name="Label3"
            Grid.Column="4"
            Margin="3"
            VerticalAlignment="Center"
            Text="b*:" />
        <TextBox
            Name="txt3"
            Grid.Column="5"
            MinWidth="60"
            MaxWidth="150"
            Margin="3"
            VerticalAlignment="Center"
            KeyDown="KeyDown"
            Text="{Binding Path=Value3, StringFormat=F4}" />
    </Grid>
</UserControl>
