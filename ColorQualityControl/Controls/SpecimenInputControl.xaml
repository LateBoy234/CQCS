<UserControl x:Class="ThreeNH.Controls.SpecimenInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ThreeNH.Controls"
             xmlns:s="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <local:WavelengthRangeConverter x:Key="WavelengthRangeConverter" />
    </UserControl.Resources>
    <DockPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="3" Text="{StaticResource Label_NameColon}" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="3" MinWidth="60"  Name="nameTxtBox"/>
                <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="3" Text="{StaticResource Label_DataTypeColon}" />
                <ComboBox Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="3"
                      SelectionChanged="OnDataTypeSelectionChanged"
                      SelectedIndex="0"
                      Name="valueTypeComboBox">
                    <ComboBoxItem Content="{StaticResource Label_Reflectance}" />
                    <ComboBoxItem Content="{StaticResource Label_ColorSpace}" />
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="3" Text="{StaticResource TransmissionFlag}" />
                <ComboBox Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="3"
                      SelectionChanged="OnTransmissionTypeSelectionChanged"
                          x:Name="transmissionCombobox"
                      SelectedIndex="0">
                    <ComboBoxItem Content="{StaticResource Reflective}"></ComboBoxItem>
                    <ComboBoxItem Content="{StaticResource Transmissive}"></ComboBoxItem>
                </ComboBox>
                <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" x:Name="colorSpaceLabel"
                           Visibility="Collapsed"
                           Margin="3" Text="{StaticResource Label_ColorSpace}" />
                <ComboBox Grid.Row="0" Grid.Column="5" VerticalAlignment="Center" Margin="3" Visibility="Collapsed"
                      SelectionChanged="OnColorSpaceTypeSelectionChanged"
                      x:Name="colorSpaceComboBox"
                      SelectedIndex="0">
                    <ComboBoxItem>CIE Lab</ComboBoxItem>
                    <ComboBoxItem>CIE XYZ</ComboBoxItem>
                    <ComboBoxItem>Hunter Lab</ComboBoxItem>
                    <ComboBoxItem>CIE RGB</ComboBoxItem>
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="3" Text="{StaticResource Label_RemarkColon}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="3" 
                     x:Name="RemarkTextBox" />
                <TextBlock Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" Margin="3" Text="{StaticResource Label_MaterialColon}" />
                <ComboBox Grid.Row="1" Grid.Column="5" Margin="3" IsEditable="True"
                      ItemsSource="{Binding Materials}"
                      Text="{Binding Material}"/>
                
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Margin="3" Header="{StaticResource Label_SpecularComponent}">
                    <local:SpecularComponentControl
                    x:Name="specularComponentControl"
                    SpecularComponentChanged="OnSpecularComponentChanged"/>
                </GroupBox>

                <GroupBox Grid.Column="1" Margin="3" Header="{StaticResource Label_WavelengthRange}"
                      x:Name="wavelengthRangeGroupBox">
                    <ComboBox Margin="5"
                          x:Name="wavelengthRangeComboBox"
                          SelectedItem="{Binding Path=WavelengthRange, 
                    Converter={StaticResource WavelengthRangeConverter}}"
                          SelectionChanged="WavelengthRange_OnSelectionChanged">
                        <s:String>400~700nm</s:String>
                        <s:String>380~740nm</s:String>
                        <s:String>360~740nm</s:String>
                        <s:String>360~780nm</s:String>
                        <s:String>300~780nm</s:String>
                    </ComboBox>
                </GroupBox>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Margin="3" Padding="3" Header="{StaticResource Label_MeasurementCaliber}">
                    <local:MeasurementCaliberComboBox x:Name="measurementCaliberControl" />
                </GroupBox>

                <GroupBox Grid.Column="1" Margin="3" Padding="3" Header="{StaticResource UV}">
                    <local:UvFlagComboBox x:Name="uvFlagComboBox" />
                </GroupBox>
            </Grid>

            <Grid Grid.Row="3" Margin="3" Name="illuminantAndObserver" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="{StaticResource Label_StandardIlluminant}">
                    <local:IlluminantComboBox x:Name="illuminantControl" Margin="6" />
                </GroupBox>
                <GroupBox Grid.Column="1" Header="{StaticResource Label_StandardObserver}">
                    <local:ObserverControl x:Name="observerControl"/>
                </GroupBox>
            </Grid>

            <GroupBox Grid.Row="4" Margin="3" Header="SCI" Name="sciGroupBox">
                <Grid>
                    <local:SpectrumInputControl x:Name="sciSpectrum" />
                    <local:ColorValueInputControl x:Name="sciColorValue" Visibility="Collapsed" />
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="5" Margin="3" Header="SCE" Name="sceGroupBox">
                <Grid>
                    <local:SpectrumInputControl x:Name="sceSpectrum" />
                    <local:ColorValueInputControl x:Name="sceColorValue" Visibility="Collapsed" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="6" Margin="3" Header="{StaticResource Label_Other}" Name="unknownGroupBox"
                  Visibility="Collapsed">
                <Grid>
                    <local:SpectrumInputControl x:Name="unknownSpectrum" />
                    <local:ColorValueInputControl x:Name="unknownColorValue" Visibility="Collapsed" />
                </Grid>
            </GroupBox>
        </Grid>
        <GroupBox DockPanel.Dock="Right"
                  Width="200"
                  Header="{StaticResource Label_ColorFormula}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Margin="5"
                         x:Name="ColorFormulaTextBox"
                         AcceptsTab="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </GroupBox>
    </DockPanel>
</UserControl>
