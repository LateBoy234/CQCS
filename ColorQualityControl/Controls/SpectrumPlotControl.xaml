<UserControl
    x:Class="ThreeNH.Controls.SpectrumPlotControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <lvc:CartesianChart
            Name="chart"
            Grid.Row="0"
            DisableAnimations="True"
            LayoutUpdated="chart_LayoutUpdated">
            <lvc:CartesianChart.AxisX>
                <lvc:Axis
                    Name="AxisX"
                    Title="{StaticResource Label_AxisWavelengthNm}"
                    MaxValue="{Binding Path=MaxWavelength}"
                    MinValue="{Binding Path=MinWavelength}">
                    <lvc:Axis.Separator>
                        <lvc:Separator Step="{Binding Path=WavelengthInterval}" />
                    </lvc:Axis.Separator>
                </lvc:Axis>
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:Axis
                    Title="{Binding Path=YAxisTitle, Mode=OneWay}"
                    MaxValue="{Binding Path=MaxReflectance}"
                    MinValue="{Binding Path=MinReflectance}" />
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>

        <Rectangle
            Name="SpectrumRectangle"
            Grid.Row="1"
            Height="20" />

    </Grid>

</UserControl>
