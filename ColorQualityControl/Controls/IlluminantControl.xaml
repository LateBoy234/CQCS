<UserControl
    x:Class="ThreeNH.Controls.IlluminantControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helper="clr-namespace:ThreeNH.Helper;assembly=ThreeNH.Helper"
    xmlns:local="clr-namespace:ThreeNH.Controls">
    <ComboBox
        Name="comboBox"
        Grid.Column="1"
        Margin="6"
        VerticalAlignment="Center"
        DisplayMemberPath="Description"
        ItemsSource="{Binding Path=Illuminant, Converter={helper:EnumToCollectionConverter}, ConverterParameter=1}"
        SelectedItem="{Binding Path=Illuminant}"
        SelectedValue="Value" />
</UserControl>
