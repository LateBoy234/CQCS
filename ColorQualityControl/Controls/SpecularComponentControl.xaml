<UserControl
    x:Class="ThreeNH.Controls.SpecularComponentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" RadioButton.Click="OnRadioButtonClick">

        <RadioButton
            Name="SCI"
            Margin="6"
            VerticalAlignment="Center"
            Content="{StaticResource SpecularComponent_SCI}" />
        <RadioButton
            Name="SCE"
            Margin="6"
            VerticalAlignment="Center"
            Content="{StaticResource SpecularComponent_SCE}" />
        <RadioButton
            Name="SCIAndSCE"
            Margin="6"
            VerticalAlignment="Center"
            Content="{StaticResource SpecularComponent_SCIAndSCE}"
            IsChecked="True" />
        <RadioButton
            Name="Unknown"
            Margin="6"
            VerticalAlignment="Center"
            Content="{StaticResource Label_Other}"
            IsChecked="True" />
    </StackPanel>
</UserControl>
