<Window x:Class="ThreeNH.LedSpectrometer.InstrumentStatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThreeNH.LedSpectrometer"
        xmlns:main="clr-namespace:ThreeNH.ColorQualityControl"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Title="{StaticResource Title_InstrumentStatus}">
    <Window.Resources>
        <main:CalibrationConverter x:Key="CalibrationConverter" />
        
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ContentStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" MinWidth="150" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" 
                   Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_ConnectionStatusColon}" />
        <TextBlock Grid.Row="0" Grid.Column="1"
                   Style="{StaticResource ContentStyle}"
                   Text="{Binding Connection}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_InstrumentModelColon}" />
        <TextBlock Grid.Row="1" Grid.Column="1"
                   Style="{StaticResource ContentStyle}"
                   Text="{Binding Path=DeviceInfo.DeviceName}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_FirmwareVersionColon}" />
        <TextBlock Grid.Row="2" Grid.Column="1"
                   Style="{StaticResource ContentStyle}"
                   Text="{Binding Path=DeviceInfo.FirmwareVersion}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_WhiteBoardNumberColon}" />
        <TextBlock Grid.Row="3" Grid.Column="1"
                   Style="{StaticResource ContentStyle}"
                   Text="{Binding Path=DeviceInfo.WhiteBoardOuterNumber}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" 
                   Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_BlackCalibrationColon}" />
        <TextBlock Grid.Row="4" Grid.Column="1"
                   Style="{StaticResource ContentStyle}"
                   Text="{Binding Path=DeviceInfo.BlackCalibration, Converter={StaticResource CalibrationConverter}}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" 
                   Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_WhiteCalibrationColon}" />
        <TextBlock Grid.Row="5" Grid.Column="1"
                   Style="{StaticResource ContentStyle}"
                   Text="{Binding Path=DeviceInfo.WhiteCalibration, Converter={StaticResource CalibrationConverter}}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" 
                   Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_CapacityColon}" />
        <TextBlock Grid.Row="6" Grid.Column="1"
                   Style="{StaticResource ContentStyle}"
                   Text="{Binding Path=DeviceInfo.Capacity}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" 
                   Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_StandardCountColon}" />
        <TextBlock Grid.Row="7" Grid.Column="1"
                   Style="{StaticResource ContentStyle}"
                   Text="{Binding Path=DeviceInfo.StandardCount}"/>

        <TextBlock Grid.Row="8" Grid.Column="0" 
                   Style="{StaticResource LabelStyle}"
                   Text="{StaticResource Label_TestColon}" />
        <TextBlock Grid.Row="8" Grid.Column="1"
                   Style="{StaticResource ContentStyle}"
                   Text="{Binding Path=DeviceInfo.TestCount}"/>

        <Button Grid.Row="9" Grid.Column="1" Margin="3, 10, 6, 3"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                MinWidth="60" IsCancel="True"
                Content="{StaticResource Label_Close}" />
    </Grid>
</Window>
