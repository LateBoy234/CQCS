<Window x:Class="ThreeNH.LedSpectrometer.WhiteBoardParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThreeNH.LedSpectrometer"
        xmlns:myctrls="clr-namespace:ThreeNH.Controls"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
               Content="{StaticResource Label_InnerNumberColon}" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="6" MinWidth="100" MaxLength="20"
                 Name="InnerNumber"/>

        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
               Content="{StaticResource Label_ExteralNumberColon}" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="6" MinWidth="100" MaxLength="20"
                 Name="OuterNumber"/>

        <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  Margin="6"
                  Header="{StaticResource Label_Reflectance}"
                  Name="groupbox">
            <myctrls:SpectrumInputControl Minimum="400" Maximum="700" Interval="10"
                                           IsPercent="True" x:Name="Reflectances" />
        </GroupBox>

        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" MinWidth="60" Margin="10" Content="{StaticResource Label_Read}"
                    Click="OnReadClick"/>
            <Button Grid.Column="1" MinWidth="60" Margin="10" Content="{StaticResource Label_Write}"
                    Click="OnWriteClick" />
            <Button Grid.Column="2" MinWidth="60" Margin="10" HorizontalAlignment="Right"
                    Content="{StaticResource Label_Close}"
                    IsDefault="True"
                    IsCancel="True" />
        </Grid>
    </Grid>
</Window>
