<Window x:Class="ThreeNH.ColorQualityControl.UI.ToleranceSettingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
        WindowStartupLocation="CenterOwner"
        Title="{StaticResource Title_ToleranceSetting}"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight">
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" Name="tabControl">
            <TabItem Header="{StaticResource Label_PrimaryTolerance}"
                     PreviewKeyDown="TabItem_PreviewKeyDown" PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown" >
                <local:ToleranceControl x:Name="PrimaryToleranceControl"
                                        IsModifiedChanged="ToleranceIsModifiedChanged"/>
            </TabItem>
            <TabItem Header="{StaticResource Label_SecondaryTolerance}"
                     PreviewKeyDown="TabItem_PreviewKeyDown" PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown" >
                <local:ToleranceControl x:Name="SecondaryToleranceControl"
                                        IsModifiedChanged="ToleranceIsModifiedChanged"/>
            </TabItem>
            <TabItem Header="{StaticResource Label_TertiaryTolerance}"
                     PreviewKeyDown="TabItem_PreviewKeyDown" PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown" >
                <local:ToleranceControl x:Name="TertiaryToleranceControl"
                                        IsModifiedChanged="ToleranceIsModifiedChanged"/>
            </TabItem>
        </TabControl>
        <GroupBox Grid.Row="1" Header="{StaticResource Label_GetToleranceFrom}"
                  Name="ToleranceFromGroupBox">
            <StackPanel Orientation="Horizontal">
                <RadioButton Margin="6"
                             Name="FromStandard"
                             Click="ToleranceIsModifiedChanged"
                             IsChecked="True" Content="{StaticResource Label_Standard}" />
                <RadioButton Margin="6"
                             Click="ToleranceIsModifiedChanged"
                             Name="FromSystemDefault" Content="{StaticResource Label_SystemSetting}" />
            </StackPanel>
        </GroupBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="6" MinWidth="60" Click="OkClick" IsDefault="True" Content="{StaticResource Label_OK}"/>
            <Button Margin="6" MinWidth="60" IsCancel="True" Content="{StaticResource Label_Cancel}"/>
            <Button Margin="6" MinWidth="60" IsEnabled="False"
                    Click="AcceptButton_Click"
                    Name="AcceptButton" Content="{StaticResource Label_Accept}" />
            <Button Margin="6" MinWidth="60" IsEnabled="False"
                    Click="RestoreButton_Click"
                    Name="RestoreButton" Content="{StaticResource Label_Restore}" />
        </StackPanel>
    </Grid>
</Window>
