<Window x:Class="ThreeNH.ColorQualityControl.UI.AutoSelectStandardSettingDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="300" MinHeight="260"
        Title="{StaticResource Title_AutoSelectStandardSetting}">
    <Window.Resources>
        <Style x:Key="textBoxInError" TargetType="TextBox">
            
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <GroupBox Grid.Row="0" Header="{StaticResource Label_AutoSelectStandardLimit}" Padding="6" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition MinWidth="100" Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Row="0" Grid.Column="0" Content="&#x0394;L*:" Margin="6" VerticalAlignment="Center"
                          IsChecked="{Binding Path=dLEnabled}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="&#x00B1;" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="2" Margin="6" IsEnabled="{Binding Path=dLEnabled}">
                    <TextBox.Text>
                        <Binding Path="dL" ValidatesOnExceptions="True">
                            <Binding.ValidationRules>
                                <DataErrorValidationRule />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <CheckBox Grid.Row="1" Grid.Column="0" Content="&#x0394;a*:" Margin="6" VerticalAlignment="Center"
                          IsChecked="{Binding Path=daEnabled}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="&#x00B1;" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="2" Margin="6" IsEnabled="{Binding Path=daEnabled}">
                    <TextBox.Text>
                        <Binding Path="da" ValidatesOnExceptions="True">
                            <Binding.ValidationRules>
                                <DataErrorValidationRule />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <CheckBox Grid.Row="2" Grid.Column="0" Content="&#x0394;b*:" Margin="6" VerticalAlignment="Center"
                          IsChecked="{Binding Path=dbEnabled}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="&#x00B1;" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="2" Margin="6" IsEnabled="{Binding Path=dbEnabled}">
                    <TextBox.Text>
                        <Binding Path="db" ValidatesOnExceptions="True">
                            <Binding.ValidationRules>
                                <DataErrorValidationRule />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <CheckBox Grid.Row="3" Grid.Column="0" Content="&#x0394;E*ab:" Margin="6" VerticalAlignment="Center"
                          IsChecked="{Binding Path=dEabEnabled}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="&#x00B1;" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="2" Margin="6" IsEnabled="{Binding Path=dEabEnabled}">
                    <TextBox.Text>
                        <Binding Path="dEab" ValidatesOnExceptions="True">
                            <Binding.ValidationRules>
                                <DataErrorValidationRule />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </Grid>
        </GroupBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Margin="0, 0, 10, 0" MinWidth="60" Content="{StaticResource Label_OK}" IsDefault="True" Click="OnOkClick" />
            <Button Margin="10, 0, 0, 0" MinWidth="60" Content="{StaticResource Label_Close}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
