<Window x:Class="ThreeNH.ColorQualityControl.UI.ConvertWhiteBoardDataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
        xmlns:colorQualityControl="clr-namespace:ThreeNH.ColorQualityControl"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Title="ConvertWhiteBoardDataDialog">
    <Window.Resources>
        <Style x:Key="labelStyle" TargetType="TextBlock">
            <Setter  Property="Margin" Value="6" />
            <Setter  Property="VerticalAlignment" Value="Center" />
        </Style>
        <CollectionViewSource x:Key="columnLetters" Source="{Binding Path=Columns}" />
        <CollectionViewSource x:Key="rows" Source="{Binding Path=Rows}" />
        <colorQualityControl:InstrumentTypeToInt x:Key="instrumentTypeConverter" />
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock  Style="{StaticResource labelStyle}" Margin="6, 6, 6, 12" 
                        Text="{StaticResource Label_WorksheetColon}"/>
            <ComboBox Grid.ColumnSpan="4" Margin="6, 6, 6, 12" MinWidth="120"
                      Name="sheetNameComboBox"
                      SelectionChanged="sheetNameComboBox_SelectionChanged"/>
        </StackPanel>
        
        <Grid DockPanel.Dock="Bottom" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="2"  Margin="6" MinWidth="72" Click="Ok_Click" IsDefault="True"
                    Content="{StaticResource Label_OK}"/>
            <Button Grid.Column="3"  Margin="6" MinWidth="72" IsCancel="True"
                    Content="{StaticResource Label_Cancel}" />
        </Grid>
        <CheckBox DockPanel.Dock="Bottom" VerticalAlignment="Center" 
                  HorizontalAlignment="Right"
                  IsChecked="{Binding Path=ReplaceInLocal}"
                  Margin="6"
                  Content="{StaticResource ReplaceInLocal}"/>

        <Grid HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Margin="6"
                    BorderThickness="1" CornerRadius="5" 
                    BorderBrush="{x:Static SystemColors.ActiveBorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource labelStyle}" 
                               Text="{StaticResource Label_StartRowColon}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="6"
                              ItemsSource="{Binding Rows}" SelectedItem="{Binding StartRow}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource labelStyle}" 
                               Text="{StaticResource Label_EndRowColon}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="6"
                              SelectedItem="{Binding EndRow}">
                        <ComboBox.ItemsSource>
                            <CompositeCollection>
                                <ComboBoxItem Content="{StaticResource Label_Default}" />
                                <CollectionContainer Collection="{Binding Source={StaticResource rows}}">
                                </CollectionContainer>
                            </CompositeCollection>
                        </ComboBox.ItemsSource>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Margin="6"
                    BorderThickness="1" BorderBrush="{x:Static SystemColors.ActiveBorderBrush}"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" MinWidth="80" />
                    </Grid.ColumnDefinitions>

                    <TextBlock  Grid.Row="0" Grid.Column="0" Style="{StaticResource labelStyle}"
                                Text="{StaticResource Label_LabColumnColon}"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" Margin="6"
                              SelectedItem="{Binding LabStartColumn}">
                        <ComboBox.ItemsSource>
                            <CompositeCollection >
                                <ComboBoxItem  IsEnabled="True" Foreground="Black"
                                               Content="{StaticResource Label_None}"/>
                                <CollectionContainer  Collection="{Binding Source={StaticResource columnLetters}}" />
                            </CompositeCollection>
                        </ComboBox.ItemsSource>
                    </ComboBox>

                    <TextBlock  Grid.Row="1" Grid.Column="0" Style="{StaticResource labelStyle}"
                                Text="{StaticResource Label_SpectrumColumnColon}"/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" Margin="6"  
                      ItemsSource="{Binding Columns}" SelectedItem="{Binding WaveStartColumn}" />

                    <TextBlock  Grid.Row="2" Grid.Column="0" Style="{StaticResource labelStyle}" 
                                Text="{StaticResource Label_WavelengthRangeColon}"/>
                    <ComboBox  Grid.Row="2" Grid.Column="1" Margin="6" 
                      Name="waveRangeCmbBox"
                      SelectedItem="{Binding WavelengthRange}" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
