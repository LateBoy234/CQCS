<Page
    x:Class="ThreeNH.ColorQualityControl.UI.ClarityCalibrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="10,5,0,5"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <Image
                Width="30"
                Height="30"
                Source="../Images/Calibration.png" />
            <TextBlock
                x:Name="Title_BlackCalibration"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Text="{StaticResource MenuItem_ClarityCalibration}" />
        </StackPanel>
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="30,10,30,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="16"
            Text="{StaticResource ClarityCalibrationPrompt}"
            TextWrapping="Wrap" />
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="btnBlackCalibration"
                Width="Auto"
                Height="35"
                MinWidth="85"
                Margin="10"
                Command="{Binding ClarityCalibrationCommand}"
                Content="{StaticResource Label_Measure}" />
            <Button
                x:Name="btnClose"
                Height="35"
                MinWidth="85"
                Margin="10"
                Command="{Binding CloseCommand}"
                Content="{StaticResource Label_Close}" />
        </StackPanel>
    </Grid>
</Page>
