<UserControl x:Class="ThreeNH.ColorQualityControl.UI.Charts.TriaxialChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:converters="clr-namespace:ThreeNH.ColorQualityControl.Converters"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactions">
    <!-- 20191206 lilin 500 -> 180 400 -> 200 -->
    <UserControl.Resources>
        <converters:SimpleArithmeticConverter x:Key="ArithmeticConverter" />
        <Style TargetType="TextBlock" />
        <Style TargetType="TextBlock"
               x:Key="ColorLabelStyle">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Panel.ZIndex" Value="999" />
        </Style>

        <lvc:DefaultTooltip x:Key="DataTooltip"
                            x:Shared="False"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            Opacity="0.75"/>
        <lvc:DefaultTooltip x:Key="PlainTooltip"
                            x:Shared="False"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            BulletSize="0"
                            Opacity="0.75"
                            ShowTitle="False"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 固定最小宽度，避免 ΔL 条过窄时 Y 轴标签挤占绘图区导致散点不可见 -->
            <ColumnDefinition Width="50" MinWidth="50" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!-- Z（ΔL 亮度条） -->
        <lvc:CartesianChart x:Name="ZChart"
                            Grid.Column="0"
                            MinWidth="50"
                            Margin="0"
                            DisableAnimations="True"
                            DataTooltip="{StaticResource DataTooltip}"
                            Series="{Binding ZChartSeriesCollection}"
                            VisualElements="{Binding ZVisualElements}">
            <lvc:CartesianChart.AxisX>
                <lvc:AxesCollection>
                    <!-- 收窄 X 范围并隐藏标签，把水平空间留给散点 -->
                    <lvc:Axis MinValue="-0.5" MaxValue="0.5"
                          ShowLabels="False"
                          Foreground="Transparent">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1" Stroke="Transparent" />
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:AxesCollection>
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:AxesCollection>
                    <lvc:Axis MinRange="{Binding AxisZMinRange}"
                          MaxRange="{Binding AxisZMaxRange}"
                          MinValue="{Binding AxisZMin}" 
                          MaxValue="{Binding AxisZMax}"
                          Title="{Binding AxisZTitle}"
                          Sections="{Binding AxisZSections}"
                          LabelFormatter="{Binding ZLabelFormatter}"
                          FontSize="9">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="{Binding AxisZSeparatorStep}"
                                       Stroke="{DynamicResource SeperatorBrush}"
                                       StrokeDashArray="2"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:AxesCollection>
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>

        <!-- X,Y -->
        <lvc:CartesianChart x:Name="XyChart"
                            Grid.Column="1"
                            DisableAnimations="True"
                            LegendLocation="{Binding LegendLocation}"
                            DataTooltip="{StaticResource DataTooltip}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            Series="{Binding XyChartSeriesCollection}"
                            VisualElements="{Binding VisualElements}"
                            SnapsToDevicePixels="True">
            <lvc:CartesianChart.AxisX>
                <lvc:AxesCollection>
                    <lvc:Axis Position="LeftBottom"
                        MinRange="{Binding AxisXMinRange}"
                          MaxRange="{Binding AxisXMaxRange}"
                          MinValue="{Binding AxisXMin}"
                          MaxValue="{Binding AxisXMax}"
                          Title="{Binding AxisXTitle}"
                          Sections="{Binding AxisXSections}"
                          LabelFormatter="{Binding XLabelFormatter}">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="{Binding AxisXSeparatorStep}"
                                       Stroke="Black"
                                       StrokeThickness="0.2"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:AxesCollection>
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:AxesCollection>
                    <lvc:Axis Position="RightTop"
                          MinRange="{Binding AxisYMinRange}"
                          MaxRange="{Binding AxisYMaxRange}"
                          MinValue="{Binding AxisYMin}"
                          MaxValue="{Binding AxisYMax}"
                          Title="{Binding AxisYTitle}"
                          Sections="{Binding AxisYSections}"
                          LabelFormatter="{Binding YLabelFormatter}">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="{Binding AxisYSeparatorStep}"
                                       Stroke="Black"
                                       StrokeThickness="0.2"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:AxesCollection>
            </lvc:CartesianChart.AxisY>

        </lvc:CartesianChart>
    </Grid>
</UserControl>
