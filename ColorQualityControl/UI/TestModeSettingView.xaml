<Window x:Class="ThreeNH.ColorQualityControl.UI.TestModeSettingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
        mc:Ignorable="d"
        Title="{StaticResource H_TestSetting}" Height="360" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <GroupBox Header="{StaticResource Standard}" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10">
                    <RadioButton Name="rd_stdSinggle" Content="{StaticResource rd_SingleMeasure}"  FontSize="16"  Margin="30 0 10 0" Checked="OnModeChanged" Unchecked="OnModeChanged"/>
                    <RadioButton Name="re_stdContinu" Content="{StaticResource rd_ContinuousMeasure}"  FontSize="16"   Margin="10 0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="20 0" Orientation="Horizontal"  Name="panelStandardContinuous">
                    <StackPanel Orientation="Horizontal" Margin="20 10" HorizontalAlignment="Left">
                        <TextBlock Text="{StaticResource label_Times}" FontSize="16" Margin="5 0" />
                        <TextBox x:Name="tb_measureTimes" MinWidth="50" Margin="5 0" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20 10" HorizontalAlignment="Right">
                        <TextBlock Text="{StaticResource label_MeasureInterval}" FontSize="16" Margin="5 0"/>
                        <TextBox x:Name="tb_measureInterval" MinWidth="50" Margin="5 0" FontSize="16"/>
                        <TextBlock Text="s" FontSize="16"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </GroupBox>
        <GroupBox Header="{StaticResource Test}" Margin="5" Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10">
                    <RadioButton Name="rd_samSinggle" Content="{StaticResource rd_SingleMeasure}"  FontSize="16"  Margin="30 0 10 0" Checked="OnModeChanged" Unchecked="OnModeChanged"/>
                    <RadioButton Name="re_samContinu" Content="{StaticResource rd_ContinuousMeasure}"  FontSize="16"   Margin="10 0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="20 0" Orientation="Horizontal" Name="panelTestContinuous" >
                    <StackPanel Orientation="Horizontal" Margin="20 10" HorizontalAlignment="Left">
                        <TextBlock Text="{StaticResource label_Times}" FontSize="16" Margin="5 0"/>
                        <TextBox x:Name="tb_samMeasureTimes" MinWidth="50" Margin="5 0" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20 10" HorizontalAlignment="Right">
                        <TextBlock Text="{StaticResource label_MeasureInterval}" FontSize="16" Margin="5 0"/>
                        <TextBox x:Name="tb_samMeasureInterval" MinWidth="50" Margin="5 0" FontSize="16"/>
                        <TextBlock Text="s" FontSize="16"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </GroupBox>
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin=" 10">
            <Button Margin="6" MinWidth="60" Height="30" Click="OkClick" IsDefault="True" Content="{StaticResource Label_OK}"/>
            <Button Margin="6" MinWidth="60" Height="30" Click="CancleClick" IsDefault="True" Content="{StaticResource Label_Cancel}"/>
        </StackPanel>
    </Grid>
</Window>
