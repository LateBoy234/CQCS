<Window x:Class="ThreeNH.ColorQualityControl.UI.ColorMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
        xmlns:controls="clr-namespace:ThreeNH.Controls"
        xmlns:helper="clr-namespace:ThreeNH.Helper;assembly=ThreeNH.Helper"
        mc:Ignorable="d"
        xmlns:cvt="clr-namespace:ThreeNH.ColorQualityControl.Converters"
        Title="ColorMatchWindow"
        Width="1000"
        Height="700"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:MatchedColorSampleNameConverter x:Key="SampleNameConverter" />
        <helper:EnumItemConverter x:Key="EnumItemConverter" />
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <RoutedUICommand x:Key="CmdPrint" 
                         Text="{StaticResource MenuItem_Print}"/>
        <RoutedUICommand x:Key="CmdPrintToWord" 
                         Text="{StaticResource MenuItem_PrintToWord}"/>
        <RoutedUICommand x:Key="CmdImportIntoStandardList" 
                         Text="{StaticResource MenuItem_ImportToStandardList}"/>
        <RoutedUICommand x:Key="CmdExportToExcel" />
        <cvt:DoubleToAbsConverter x:Key="DoubleToAbsConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--存样库选择-->
        <GroupBox Grid.Row="0" Grid.Column="0"
                  Header="{StaticResource Label_LibraryOptions}">
            <StackPanel  Orientation="Horizontal">
                <TextBlock Style="{StaticResource FormTextBlockStyle}" 
                           Text="{DynamicResource Label_LibraryColon}"/>
                <ComboBox Style="{StaticResource FormComboBoxStyle}"
                          ItemsSource="{Binding LibraryNames}"
                          SelectedItem="{Binding CurrentLibrary}"
                          SelectionChanged="OnCurrentLibraryChanged"/>
                <TextBlock Style="{StaticResource FormTextBlockStyle}"
                           Text="{StaticResource Label_MaterialColon}" />
                <ComboBox Style="{StaticResource FormComboBoxStyle}" 
                          ItemsSource="{Binding Materials}"
                          SelectedItem="{Binding Path=SelectedMaterial}"
                          SelectionChanged="OnMaterialsSelectionChanged"/>
            </StackPanel>
        </GroupBox>
        <GridSplitter Grid.Row="0"
                      Grid.RowSpan="2"
                      Grid.Column="1"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Center"
                      Width="3" />
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 要查找的样品 -->
            <GroupBox Header="{StaticResource Label_TestSample}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource FormTextBlockStyle}"
                               Text="{StaticResource Label_NameColon}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" 
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding Samples}"
                              SelectionChanged="OnCurrentSampleChanged"
                              SelectedItem="{Binding SelectedSample}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource SampleNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Row="0" Grid.Column="2" 
                            Style="{StaticResource ButtonStyle}"
                            Content="{StaticResource Label_Measure}"
                            Click="MeasureButton_OnClick"
                            IsDefault="True" Margin="6"/>


                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FormTextBlockStyle}"
                                   Text="L*"/>
                        <TextBox Style="{StaticResource FormTextBoxStyle}"
                                 Width="72"
                                 Text="{Binding Path=Lab_L, StringFormat=F2}"/>

                        <TextBlock Style="{StaticResource FormTextBlockStyle}"
                                   Text="a*"/>
                        <TextBox Style="{StaticResource FormTextBoxStyle}" 
                                 Width="72"
                                 Text="{Binding Path=Lab_a, StringFormat=F2}"/>

                        <TextBlock Style="{StaticResource FormTextBlockStyle}"
                                   Text="b*"
                                   />
                        <TextBox Style="{StaticResource FormTextBoxStyle}" 
                                 Width="72"
                                 Text="{Binding Path=Lab_b, StringFormat=F2}"/>


                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="2"
                            Style="{StaticResource ButtonStyle}"
                            Content="{StaticResource Label_Search}"
                            Click="OnSearchClick"/>
                </Grid>
            </GroupBox>
            <!--过滤条件-->
            <GroupBox Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                
                    
                    <TextBlock Grid.Column="6" 
                               Text="{StaticResource dEab}"
                                Style="{StaticResource FormTextBlockStyle}" 
                               />
                    <TextBox
                        Style="{StaticResource FormTextBoxStyle}" 
                        Width="72"
                        Grid.Column="7" 
                             Text="{Binding DeltaELimit, StringFormat=F2, UpdateSourceTrigger=PropertyChanged, Delay=800
                         }"  />
                </Grid>

            </GroupBox>

            <!--查找结果-->
            <GroupBox Grid.Row="2" Header="查找结果">
                <DataGrid AutoGenerateColumns="False"
                          x:Name="ResultsDataGrid"
                          IsReadOnly="True"
                          ItemsSource="{Binding DataView}"
                          SelectedItem="{Binding SelectedColorRow}"
                          MinWidth="500">
                    <!--<DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="打印" 
                                      Click="Print_OnClick"/>
                            <MenuItem Header="打印到Word" 
                                      Click="PrintToWord_OnClick"/>
                            <MenuItem Header="导出到Excel"
                                      Click="ExportToExcel_OnClick"/>
                            <MenuItem Header="导入为标样"
                                      Click="ImportAsStandards_OnClick"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>-->
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{StaticResource Label_Number}" 
                                            Binding="{Binding Number}"/>
                        <DataGridTextColumn Header="{StaticResource Label_DateTime}"
                                            Binding="{Binding DateTime}" />
                        <DataGridTextColumn Header="{StaticResource Material}"
                                            Binding="{Binding Material}" />
                        <DataGridTextColumn Header="{StaticResource Label_StandardIlluminant}"
                                            Binding="{Binding Illuminant, Converter={StaticResource EnumItemConverter}}"/>
                        <DataGridTextColumn Header="{StaticResource Label_Observer}"
                                            Binding="{Binding Observer, Converter={StaticResource EnumItemConverter}}" />
                        <DataGridTextColumn Header="&#x0394;L*" 
                                            Binding="{Binding Delta.dL, StringFormat=F2}" />
                        <DataGridTextColumn Header="&#x0394;a*" 
                                            Binding="{Binding Delta.da, StringFormat=F2}" />
                        <DataGridTextColumn Header="&#x0394;b*" 
                                            Binding="{Binding Delta.db, StringFormat=F2}" />
                        <DataGridTextColumn Header="&#x0394;E*" 
                                            Binding="{Binding Delta.dE, StringFormat=F2}" />
                        
                        <DataGridTextColumn Header="{StaticResource Label_Remark}"
                                            Binding="{Binding Remark}" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" HorizontalAlignment="Center"
                         MinWidth="200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Grid.Row="0"
                           Margin="3"
                           HorizontalAlignment="Center"
                           Text="{StaticResource Label_TargetColor}" />
                <TextBlock Grid.Column="1" Grid.Row="0"
                           Margin="3"
                           HorizontalAlignment="Center"
                           Text="{StaticResource Label_StoredColor}" />
                <Rectangle Grid.Column="0" Grid.Row="1"
                           Fill="{Binding SampleColor}"
                            Height="50"/>
                <Rectangle Grid.Column="1" Grid.Row="1"
                           Fill="{Binding StoredSampleColor}"
                           Height="50"/>
            </Grid>
            <GroupBox Grid.Row="1" Header="{StaticResource Label_ColorFormula}">
                <TextBox Margin="5" IsReadOnly="True" Height="100"
                         Text="{Binding ElementName=ResultsDataGrid, Path=SelectedItem.ColorFormula}"/>
            </GroupBox>
            <GroupBox Grid.Row="2" Header="{StaticResource Label_ChromaticDiagram}">
                <ContentControl x:Name="ToleranceChartView" MinHeight="200" />
            </GroupBox>
            <GroupBox Grid.Row="3" Header="{StaticResource Label_SpectrumDiagram}">
                <controls:SpectrumPlotControl x:Name="SpectrumPlotControl"
                                              MinReflectance="0"
                                              MaxReflectance="120"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
