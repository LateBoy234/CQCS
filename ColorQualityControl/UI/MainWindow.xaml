        <CommandBinding Command="{x:Static local:Commands.PathlenthSelect}"  Executed="PathlenthSelectExecuted"/>
        <CommandBinding Command="{x:Static local:Commands.TestModeSetting}"  Executed="TestModeSettingExecuted"/>
        <CommandBinding Command="{x:Static local:Commands.StandardChromaticitySetting}" Executed="StandardChromaticitySettingExecuted" />
        <CommandBinding Command="{x:Static local:Commands.SetAsCurrentStandard}" Executed="SetAsCurrentStandardExecuted" />
        <CommandBinding Command="SaveAs" Executed="SaveAsExecuted" />
        <CommandBinding Command="Save" Executed="SaveExecuted" />
        <CommandBinding Command="New" Executed="NewExecuted" />
        <CommandBinding Command="Open" Executed="OpenExecuted" />
        <CommandBinding
            CanExecute="CanActOnSpecimen"
            Command="Delete"
            Executed="DeleteExecuted" />

        <CommandBinding
            CanExecute="InstrumentOperationCanExecuted"
            Command="{x:Static local:Commands.PanTongMatchSearchLilin}"
            Executed="MatchAndSearchExecuted" />

        <CommandBinding Command="Find" Executed="FindExecuted" />
        <CommandBinding
            CanExecute="CanActOnSpecimen"
            Command="{x:Static local:Commands.Rename}"
            Executed="RenameExecuted" />
        <CommandBinding
            CanExecute="CanActOnSpecimen"
            Command="{x:Static local:Commands.ModifyMaterial}"
            Executed="ModifyMaterialExecuted" />
        <CommandBinding Command="{x:Static local:Commands.SetRulesOfAutoNaming}" Executed="SetRulesOfAutoNamingExecuted" />
        <CommandBinding
            CanExecute="CanActOnSpecimen"
            Command="{x:Static local:Commands.MoveToStandard}"
            Executed="MoveToStandardExecuted" />
        <CommandBinding
            CanExecute="CanActOnStandard"
            Command="{x:Static local:Commands.CopyToTest}"
            Executed="CopyToTestExecuted" />
        <CommandBinding
            CanExecute="CanActOnStandard"
            Command="{x:Static local:Commands.CopyToUnderAStandard}"
            Executed="CopyToUnderAStandard" />
        <CommandBinding
            CanExecute="CanActOnSpecimen"
            Command="{x:Static local:Commands.ChangeStandard}"
            Executed="ChangeStandardExecuted" />
        <CommandBinding Command="{x:Static local:Commands.ExportAll}" Executed="ExportAllExecuted" />
        <CommandBinding
            CanExecute="CanActOnSpecimen"
            Command="{x:Static local:Commands.ExportSelected}"
            Executed="ExportSelectedExecuted" />
        <CommandBinding
            CanExecute="CanActOnStandard"
            Command="{x:Static local:Commands.ExportSelectedWithTests}"
            Executed="ExportSelectedWithTestsExecuted" />
        <!--<CommandBinding Command="{x:Static local:Commands.PrinterSetup}"
                        Executed="PrinterSetupExecuted" />-->
        <CommandBinding
            CanExecute="CanActOnSpecimen"
            Command="Print"
            Executed="PrintExecuted" />
        <CommandBinding
            CanExecute="CanActOnSpecimen"
            Command="PrintPreview"
            Executed="PrintPreviewExecuted" />
        <CommandBinding
            CanExecute="CanActOnSpecimen"
            Command="{x:Static local:Commands.PrintToWord}"
            Executed="PrintToWordExecuted" />
        <CommandBinding Command="{x:Static local:Commands.About}" Executed="AboutExecuted" />
        <!--扫码-->
        <!--<CommandBinding Command="{x:Static local:Commands.OpenScanBarcodeDialog}" Executed="OpenScanBarcodeDialogExecuted" />
        <CommandBinding Command="{x:Static local:Commands.CloudSetting}" Executed="CloudSettingExecuted" />-->

        <CommandBinding
            CanExecute="CanActOnSpecimen"
            Command="{x:Static local:Commands.PrintToPDF}"
            Executed="PrintToPDFExecuted" />
        <CommandBinding Command="{x:Static local:Commands.Update}" Executed="UpdateExecuted" />

        <CommandBinding
            CanExecute="OpenUserManualCanExecute"
            Command="Help"
            Executed="OpenUserManualExecuted" />

        <CommandBinding Command="{x:Static local:Commands.SetReportInfo}" Executed="SetReportInfoExecuted" />

        <CommandBinding Command="{x:Static local:Commands.AutoSelectStandardSetting}" Executed="AutoSelectStandardSettingExecuted" />

        <CommandBinding
            CanExecute="AutoMatchStandardCanExecute"
            Command="{x:Static local:Commands.AutoMatchStandard}"
            Executed="AutoMatchStandardExecuted" />
        
        <CommandBinding
            CanExecute="GotoStandardCanExecute"
            Command="{x:Static local:Commands.GotoStandard}"
            Executed="GotoStandardExecuted" />

        <CommandBinding
    CanExecute="SwitchToStandardCanExecute"
    Command="{x:Static local:Commands.SwitchToStandard}"
    Executed="SwitchToStandardExecuted" />
        
        <CommandBinding
            CanExecute="ShowAssociatedTestsCanExecute"
            Command="{x:Static local:Commands.ShowAssociatedTests}"
            Executed="ShowAssociatedTestsExecuted" />

        <!--  NR Tools 命令  -->
        <CommandBinding
            CanExecute="InstrumentOperationCanExecuted"
            Command="{StaticResource YR_WhiteBoardSetting}"
            Executed="YR_WhiteBoardSetting_Executed" />
        <CommandBinding
            CanExecute="InstrumentOperationCanExecuted"
            Command="{StaticResource YR_GetSamplingData}"
            Executed="YR_GetSamplingData_Executed" />
        <CommandBinding
            CanExecute="InstrumentOperationCanExecuted"
            Command="{StaticResource YR_UploadData}"
            Executed="YR_UploadData_Executed" />
        <!--<CommandBinding Command="{StaticResource YR_Measure}"
                        Executed="YR_Measure_Executed"
                        CanExecute="InstrumentOperationCanExecuted" />-->
        <!--  <CommandBinding Command="{x:Static local:Commands.NewLibrary}"  -->
        <!--  Executed="OnNewLibrary"/>  -->
        <!--  <CommandBinding Command="{x:Static local:Commands.ImportLibrary}"  -->
        <!--  Executed="OnImportLibrary"/>  -->

        <!--  存样库  -->
        <CommandBinding
            CanExecute="CanAddToLibrary"
            Command="{x:Static local:Commands.AddToLibrary}"
            Executed="OnAddToLibrary" />
        <CommandBinding Command="{x:Static local:Commands.ManageLibrary}" Executed="OnManageLibrary" />
        <CommandBinding Command="{x:Static local:Commands.ConvertWhiteBoardData}" Executed="OnConvertWhiteBoardData" />
        <CommandBinding
            CanExecute="InstrumentOperationCanExecuted"
            Command="{x:Static local:Commands.InstrumentMeasurementConfigs}"
            Executed="OnInstrumentMeasurementConfigs" />
        <CommandBinding Command="{x:Static local:Commands.FindClosedColorsFromLibrary}" Executed="OnFindClosedColorsFromLibrary" />

        <!--  仪器存样库管理  -->
        <CommandBinding
            CanExecute="InstrumentLibraryOperationCanExecuted"
            Command="{x:Static local:Commands.WriteToInstrumentLibrary}"
            Executed="OnWriteToInstrumentLibrary" />
        <CommandBinding
            CanExecute="InstrumentLibraryOperationCanExecuted"
            Command="{x:Static local:Commands.ReadInstrumentLibrary}"
            Executed="OnReadInstrumentLibrary" />
        <CommandBinding
            CanExecute="InstrumentLibraryOperationCanExecuted"
            Command="{x:Static local:Commands.ClearInstrumentLibrary}"
            Executed="OnClearInstrumentLibrary" />
        <CommandBinding
            CanExecute="InstrumentLibraryOperationCanExecuted"
            Command="{x:Static local:Commands.UpdateInstrumentLibrary}"
            Executed="OnUpdateInstrumentLibrary" />
        <CommandBinding
            CanExecute="StandardSampleReportCanExexuted"
