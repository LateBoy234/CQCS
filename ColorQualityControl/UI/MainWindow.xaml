<Window
    x:Class="ThreeNH.ColorQualityControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="clr-namespace:ThreeNH.ColorQualityControl.UI.Charts"
    xmlns:helper="clr-namespace:ThreeNH.Helper;assembly=ThreeNH.Helper"
    xmlns:local="clr-namespace:ThreeNH.ColorQualityControl"
    xmlns:myctrls="clr-namespace:ThreeNH.Controls"
    xmlns:optical="clr-namespace:ThreeNH.Optical;assembly=OpticalDefines"
    xmlns:toolkit="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
    xmlns:ui="clr-namespace:ThreeNH.ColorQualityControl.UI"
    Closed="OnClosed"
    Loaded="OnLoaded"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="MenuItemIconStyle" TargetType="Image">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="UniformToFill" />
        </Style>
        <DataTemplate x:Key="LibraryMenuItemHeaderTemplate" DataType="{x:Type HeaderedContentControl}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Grid.Column="0"
                    Width="16"
                    Height="16"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Source="../Images/cab.ico" />
                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" />
            </Grid>
        </DataTemplate>
        <ContextMenu x:Key="StandardContextMenu" Opened="StandardContextMenu_OnOpened" >
            <MenuItem Command="{x:Static local:Commands.ShowAssociatedTests}" />
            <MenuItem Command="{x:Static local:Commands.SetAsCurrentStandard}" />
            <MenuItem Command="{x:Static local:Commands.StandardToleranceSetting}" />
            <!--<MenuItem Command="{x:Static local:Commands.StandardChromaticitySetting}" />-->
            <MenuItem Command="{x:Static local:Commands.CopyToTest}" />
            <MenuItem Command="{x:Static local:Commands.CopyToUnderAStandard}" />
            <Separator />
            <MenuItem Command="{x:Static local:Commands.FindClosedColorsFromLibrary}" />
            <Separator />
            <MenuItem
                x:Name="AddToLibraryMenuItem"
                Command="{x:Static local:Commands.AddToLibrary}"
                Header="{StaticResource MenuItem_AddToLibrary}" />
            <MenuItem Command="{x:Static local:Commands.Rename}" />
            <MenuItem Command="{x:Static local:Commands.ModifyMaterial}" />
            <MenuItem Command="{x:Static local:Commands.WriteStandardToInstrument}" Header="{StaticResource MenuItem_WriteStandardToInstrument}" />
            <MenuItem Command="Delete">
                <MenuItem.Icon>
                    <Image Source="../Images/Delete.png" Style="{StaticResource MenuItemIconStyle}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{x:Static local:Commands.ExportSelected}" />
            <MenuItem Command="{x:Static local:Commands.ExportSelectedWithTests}" />
            <MenuItem Command="{x:Static local:Commands.StandardSampleReport}" />
            <MenuItem Command="{x:Static local:Commands.PanTongMatch}" />
        </ContextMenu>
        <ContextMenu x:Key="TestContextMenu">
            <MenuItem Command="{x:Static local:Commands.GotoStandard}" />
            <MenuItem Command="{x:Static local:Commands.SwitchToStandard}" />
            <MenuItem Command="{x:Static local:Commands.AutoMatchStandard}" />
            <MenuItem Command="{x:Static local:Commands.ChangeStandard}" />
            <MenuItem Command="{x:Static local:Commands.MoveToStandard}" />
            <Separator />
            <MenuItem Command="{x:Static local:Commands.Rename}" />
            <MenuItem Command="{x:Static local:Commands.ModifyMaterial}" />
            <MenuItem Command="Delete">
                <MenuItem.Icon>
                    <Image Source="../Images/Delete.png" Style="{StaticResource MenuItemIconStyle}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{x:Static local:Commands.ExportSelected}" />
            <MenuItem Command="{x:Static local:Commands.TestSampleReport}" />
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="_booleanToVisibilityConverter" />

        <!--  YR、NR工具栏命令  -->
        <RoutedUICommand x:Key="YR_WhiteBoardSetting" Text="YR 白板参数设置..." />
        <RoutedUICommand x:Key="YR_GetSamplingData" Text="YR 原始数据测量..." />
        <RoutedUICommand x:Key="YR_UploadData" Text="YR 数据上传..." />
        <!--<RoutedUICommand x:Key="YR_Measure" Text="YR 测量..." />-->

        <!--  NS系列仪器的工具菜单  -->
        <MenuItem
            x:Key="NSToolsMenuItem"
            Header="Tools"
            Tag="Tools" />
        <!--  YS系列的仪器的工具的菜单  -->
        <MenuItem
            x:Key="YSToolsMenuItem"
            Header="Tools"
            Tag="Tools" />
        <!--  YR系列的仪器的工具菜单  -->
        <MenuItem
            x:Key="YRToolsMenuItem"
            Header="Tools"
            Tag="Tools">
            <MenuItem Command="{StaticResource YR_WhiteBoardSetting}" />
            <MenuItem Command="{StaticResource YR_GetSamplingData}" />
            <MenuItem Command="{StaticResource YR_UploadData}" />
        </MenuItem>
        <!--  NR系列的仪器的工具菜单  -->
        <MenuItem
            x:Key="NRToolsMenuItem"
            Header="Tools"
            Tag="Tools" />

        <!--  BTS系列的仪器的工具菜单  -->
        <MenuItem
            x:Key="BTSToolsMenuItem"
            Header="Tools"
            Tag="Tools" />

        <Style x:Key="LabelWithBorder" TargetType="Label">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{x:Static SystemColors.ActiveBorderBrush}" />
        </Style>
        <!-- <Style x:Key="ToolButtonImageStyle" TargetType="Image"> -->
        <!--     <Style.Triggers> -->
        <!--         <Trigger Property="IsEnabled" Value="False"> -->
        <!--             <Setter Property="Opacity" Value="0.5" /> -->
        <!--         </Trigger> -->
        <!--     </Style.Triggers> -->
        <!--     <Style.Setters> -->
        <!--         <Setter Property="Width" Value="32" /> -->
        <!--         <Setter Property="Height" Value="32" /> -->
        <!--     </Style.Setters> -->
        <!-- </Style> -->
        <!-- <Style x:Key="ToolButtonStyle" TargetType="Button"> -->
        <!--     <Style.Setters> -->
        <!--         <Setter Property="Padding" Value="3" /> -->
        <!--     </Style.Setters> -->
        <!--</Style>-->
        <Style TargetType="DataGridCell">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="Foreground" Value="Green" />
                    <Setter Property="Background" Value="LightBlue" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <helper:EnumItemConverter x:Key="EnumItemConverter" />

    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="CloseExecuted" />
        <CommandBinding
            CanExecute="ConnectCanExected"
            Command="{x:Static local:Commands.Connect}"
            Executed="ConnectExecuted" />
        <CommandBinding
            CanExecute="InstrumentOperationCanExecuted"
            Command="{x:Static local:Commands.Disconnect}"
            Executed="DisconnectExecuted" />
        <CommandBinding
            CanExecute="InstrumentOperationCanExecuted"
            Command="{x:Static local:Commands.MeasureStandard}"
            Executed="MeasureStandardExecuted" />
        <CommandBinding
            CanExecute="InstrumentOperationCanExecuted"
            Command="{x:Static local:Commands.MeasureTrial}"
            Executed="MeasureTrialExecuted" />
        <CommandBinding
            CanExecute="InstrumentOperationCanExecuted"
            Command="{x:Static local:Commands.InstrumentStatus}"
            Executed="InstrumentStatusExecuted" />
        <CommandBinding Command="{x:Static local:Commands.ObserverAndIlluminant}" Executed="ObserverAndIlluminantExecuted" />
        <CommandBinding Command="{x:Static local:Commands.ChromaticitySetting}" Executed="ChromaticitySettingExecuted" />
        <CommandBinding Command="{x:Static local:Commands.ToleranceSetting}" Executed="ToleranceSettingExecuted" />
        <CommandBinding
            CanExecute="InstrumentOperationCanExecuted"
            Command="{x:Static local:Commands.InstrumentDataManagement}"
            Executed="InstrumentDataManagementExecuted" />
