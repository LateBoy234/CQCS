<Window x:Class="ThreeNH.ColorQualityControl.ImportStandardsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="{StaticResource MenuItem_ImportFromExcel}">
    <Window.Resources>
        <Style x:Key="labelStyle" TargetType="TextBlock">
            <Setter  Property="Margin" Value="6" />
            <Setter  Property="VerticalAlignment" Value="Center" />
        </Style>
        <CollectionViewSource x:Key="columnLetters" Source="{Binding Path=Columns}" />
        <CollectionViewSource x:Key="rows" Source="{Binding Path=Rows}" />
        <local:InstrumentTypeToInt x:Key="instrumentTypeConverter" />
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock  Style="{StaticResource labelStyle}" Margin="6, 6, 6, 12" 
                        Text="{StaticResource Label_WorksheetColon}"/>
            <ComboBox Grid.ColumnSpan="4" Margin="6, 6, 6, 12" MinWidth="120"
                      Name="sheetNameComboBox"
                      SelectionChanged="sheetNameComboBox_SelectionChanged"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="6" MinWidth="72" Click="Ok_Click" IsDefault="True"
                    Content="{StaticResource Label_OK}"/>
            <Button Margin="6" MinWidth="72" IsCancel="True"
                    Content="{StaticResource Label_Cancel}" />
        </StackPanel>
                                                                   
        <Grid HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Margin="6"
                    BorderThickness="1" CornerRadius="5" 
                    BorderBrush="{x:Static SystemColors.ActiveBorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource labelStyle}" 
                               Text="{StaticResource Label_StartRowColon}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="6"
                              ItemsSource="{Binding Rows}" SelectedItem="{Binding StartRow}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource labelStyle}" 
                               Text="{StaticResource Label_EndRowColon}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="6"
                              SelectedItem="{Binding EndRow}">
                        <ComboBox.ItemsSource>
                            <CompositeCollection>
                                <ComboBoxItem Content="{StaticResource Label_Default}" />
                                <CollectionContainer Collection="{Binding Source={StaticResource rows}}">
                                </CollectionContainer>
                            </CompositeCollection>
                        </ComboBox.ItemsSource>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Margin="6"
                    BorderThickness="1" BorderBrush="{x:Static SystemColors.ActiveBorderBrush}"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" MinWidth="80" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource labelStyle}" 
                               Text="{StaticResource Label_NameColumnColon}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="6" 
                      SelectedItem="{Binding NameColumn}">
                        <ComboBox.ItemsSource>
                            <CompositeCollection>
                                <ComboBoxItem IsEnabled="True" Foreground="Black" 
                                              Content="{StaticResource Label_None}"/>
                                <CollectionContainer Collection="{Binding Source={StaticResource columnLetters}}" />
                            </CompositeCollection>
                        </ComboBox.ItemsSource>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource labelStyle}"
                               Text="{StaticResource Label_XYZColumnColon}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="6"
                       SelectedItem="{Binding XYZStartColumn}">
                        <ComboBox.ItemsSource>
                            <CompositeCollection>
                                <ComboBoxItem IsEnabled="True" Foreground="Black" 
                                              Content="{StaticResource Label_None}"/>
                                <CollectionContainer Collection="{Binding Source={StaticResource columnLetters}}" />
                            </CompositeCollection>
                        </ComboBox.ItemsSource>
                    </ComboBox>

                    <TextBlock  Grid.Row="3" Grid.Column="0" Style="{StaticResource labelStyle}"
                                Text="{StaticResource Label_LabColumnColon}"/>
                    <ComboBox  Grid.Row="3" Grid.Column="1" Margin="6"
                              SelectedItem="{Binding LabStartColumn}">
                        <ComboBox.ItemsSource>
                            <CompositeCollection >
                                <ComboBoxItem  IsEnabled="True" Foreground="Black"
                                               Content="{StaticResource Label_None}"/>
                                <CollectionContainer  Collection="{Binding Source={StaticResource columnLetters}}" />
                            </CompositeCollection>
                        </ComboBox.ItemsSource>
                    </ComboBox>

                    <TextBlock  Grid.Row="4" Grid.Column="0" Style="{StaticResource labelStyle}"
                                Text="{StaticResource Label_SpectrumColumnColon}"/>
                    <ComboBox  Grid.Row="4" Grid.Column="1" Margin="6"  
                      ItemsSource="{Binding Columns}" SelectedItem="{Binding WaveStartColumn}" />

                    <TextBlock  Grid.Row="5" Grid.Column="0" Style="{StaticResource labelStyle}" 
                                Text="{StaticResource Label_WavelengthRangeColon}"/>
                    <ComboBox  Grid.Row="5" Grid.Column="1" Margin="6" 
                      Name="waveRangeCmbBox"
                      SelectedItem="{Binding WavelengthRange}" />


                    <TextBlock  Grid.Row="6" Grid.Column="0" Style="{StaticResource labelStyle}" 
                                Text="{StaticResource Label_SpecularComponentColon}"></TextBlock>
                    <ComboBox  Grid.Row="6" Grid.Column="1" Margin="6" SelectedIndex="1"
                               x:Name="scCmbBox">
                        <ComboBoxItem >---</ComboBoxItem>
                        <ComboBoxItem >SCI</ComboBoxItem>
                        <ComboBoxItem >SCE</ComboBoxItem>
                        <ComboBoxItem Content="{StaticResource Label_SCIFollowedBySCE}" />
                        <ComboBoxItem Content="{StaticResource Label_SCEFollowedBySCI}"/>
                    </ComboBox>
                </Grid>

            </Border>

            <Border  Grid.Row="3" Grid.Column="0" Margin="6"
                     BorderThickness="1"
                     BorderBrush="{x:Static SystemColors.ActiveBorderBrush}"
                     CornerRadius="5">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition  Width="Auto" />
                        <ColumnDefinition  Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition  Height="Auto" />
                        <RowDefinition  Height="Auto" />
                        <RowDefinition  Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource labelStyle}" 
                               Text="{StaticResource Label_ReflectiveSlashTransitiveColon}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="6"
                              SelectedIndex="0" 
                              x:Name="SpectralTypeCmbBox">
                        <ComboBoxItem Tag="Reflective" Content="{StaticResource Reflective}"/>
                        <ComboBoxItem Tag="Transitive" Content="{StaticResource Transmissive}"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource labelStyle}" 
                               Text="{StaticResource Label_OpticalStructColon}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"  Margin="6" 
                              SelectedIndex="0"
                              x:Name="opticalStructCmbBox">
                        <ComboBoxItem Tag="" Content="{StaticResource Label_Unknown}" />
                        <ComboBoxItem  Tag="d/8">d/8</ComboBoxItem>
                        <ComboBoxItem  Tag="8/d">8/d</ComboBoxItem>
                        <ComboBoxItem  Tag="45/0">45/0</ComboBoxItem>
                        <ComboBoxItem  Tag="0/45">0/45</ComboBoxItem>
                        <ComboBoxItem  Tag="d/0">d/0</ComboBoxItem>
                        <ComboBoxItem  Tag="0/d">0/d</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource labelStyle}"
                               Text="{StaticResource IlluminantAndObserver}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding IlluminantObserverPairs}"
                              SelectedItem="{Binding SelectedIlluminantObserver}"/>
                </Grid>
            </Border>

        </Grid>
    </DockPanel>
</Window>
