<Window x:Class="ThreeNH.ColorQualityControl.UI.SelectSerialPortDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
        mc:Ignorable="d"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        SizeToContent="Height"
        Title="{StaticResource Title_SelectASerialPort}" Width="400">
    <Window.Resources>
        <Style x:Key="Itemstyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <StackPanel Orientation="Horizontal" x:Name="sp" Margin="10,3,10,3">
                            <Image  Source="../Images/serialport.png" Width="18" Height="18"/>
                            <Label  Content="{Binding Description}"/>
                            <Label  Content="{Binding PortName}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" TargetName="sp">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0.5,0.22" EndPoint="0.5,1">
                                            <GradientStop Color="LightGray" Offset="0.31"/>
                                            <GradientStop Color="Gray" Offset="0.88"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="ListViewItemDoubleClick" />
        </Style>
    </Window.Resources>
    <StackPanel>
        <ListView x:Name="SelectSerialPortListView" ItemsSource="{Binding PortDevices}" IsEnabled="True" ItemContainerStyle="{StaticResource Itemstyle}">

        </ListView>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="10, 6, 10, 6" MinWidth="60" IsDefault="True" Click="OkClick" Content="{DynamicResource Label_OK}" />
            <Button Margin="10, 6, 10, 6" MinWidth="60" IsCancel="True" Click="cancelClick" Content="{DynamicResource Label_Cancel}"/>
        </StackPanel>
    </StackPanel>
</Window>
