<Window x:Class="ThreeNH.ColorQualityControl.UI.TargetLibraryManagementDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ThreeNH.ColorQualityControl.UI"
        xmlns:controls="clr-namespace:ThreeNH.Controls"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="{StaticResource Title_LibraryManagement}" Height="600" Width="900">
    <Window.Resources>
        <RoutedUICommand x:Key="AddLibrary" />
        <RoutedUICommand x:Key="ImportLibrary" />
        <RoutedUICommand x:Key="DelLibrary" />
        <RoutedUICommand x:Key="RenameLibrary" />
        <RoutedUICommand x:Key="DelSelStandards" Text="{StaticResource Label_DeleteSelectedSamples}" />
        <RoutedUICommand x:Key="RenameSelStandards" Text="{StaticResource MenuItem_Rename}" />
        <RoutedUICommand x:Key="ModifyStandards" Text="{StaticResource MenuItem_Modify}" />
        <ui:FilterMethodToVisibleConverter x:Key="FilterMethodToVisibleConverter"/>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{StaticResource AddLibrary}"
                        Executed="AddLibrary_Executed"/>
        <CommandBinding Command="{StaticResource ImportLibrary}"
                        Executed="ImportLibrary_Executed"
                        CanExecute="CanOperateOnLibrary"/>
        <CommandBinding Command="{StaticResource DelLibrary}"
                        Executed="DelLibrary_Executed"
                        CanExecute="CanOperateOnLibrary"/>
        <CommandBinding Command="{StaticResource RenameLibrary}"
                        Executed="RenameLibrary_Executed"
                        CanExecute="CanOperateOnLibrary"/>
        <CommandBinding Command="{StaticResource DelSelStandards}"
                        Executed="OnDeleteSelectedStandards"
                        CanExecute="CanDeleteStandardsExecute"/>
        <CommandBinding Command="{StaticResource RenameSelStandards}"
                        Executed="OnRenameStandard"
                        CanExecute="CanRenameStandardExecute"/>
        <CommandBinding Command="{StaticResource ModifyStandards}"
                        Executed="OnModifyStandard"
                        CanExecute="CanRenameStandardExecute"/>
    </Window.CommandBindings>
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ToolBar HorizontalAlignment="Stretch" >
            <Button ToolTip="{StaticResource Tip_CreateNewLibrary}" Command="{StaticResource AddLibrary}">
                <Image  Style="{StaticResource ToolButtonImageStyle}"
                        Source="../Images/new_cab.png" Width="24" Height="24" />
            </Button>
            <Button ToolTip="{StaticResource Tip_ImportLibrary}" Command="{StaticResource ImportLibrary}">
                <Image Style="{StaticResource ToolButtonImageStyle}"
                       Source="../Images/import_cab.png" Width="24" Height="24"/>
            </Button>
            <Button ToolTip="{StaticResource Tip_DeleteLibrary}" Command="{StaticResource DelLibrary}">
                <Image  Style="{StaticResource ToolButtonImageStyle}"
                        Source="../Images/del_cab.png" Width="24" Height="24" />
            </Button>
            <Button ToolTip="{StaticResource Tip_RenameLibrary}" Command="{StaticResource RenameLibrary}">
                <Image  Style="{StaticResource ToolButtonImageStyle}"
                        Source="../Images/Rename.ico" Width="24" Height="24" />
            </Button>
        </ToolBar>
        <ListBox Grid.Column="0" Grid.Row="1" ItemsSource="{Binding Path=Libraries}"
                 SelectionChanged="OnSelectedLibraryChanged"
                 SelectedItem="{Binding Path=SelectedLibrary}"
                 Name="LibraryListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="../Images/cab.ico" Width="16" Height="16"
                               Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Path=Name}"></TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Stretch" 
                      HorizontalAlignment="Center" Width="5"/>
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:SpecularComponentComboBox SpecularComponent="{Binding Path=Filter.SpecularComponent,Mode=TwoWay}"
                                                WithNone="True"
                                                Margin="5 " VerticalAlignment="Center" Width="80"
                                                SelectionChanged="OnSpecularComponentChanged" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource FormTextBlockStyle}"
                       Text="{StaticResource Label_SearchCondition}"/>
            <ComboBox Grid.Column="2" VerticalAlignment="Center"
                      SelectedIndex="{Binding Path=FilterMethod}"
                      SelectionChanged="OnFilterMethodChanged">
                <ComboBoxItem Content="{StaticResource Label_Name}" />
                <ComboBoxItem Content="{StaticResource Label_DateTime}"/>
                <ComboBoxItem Content="{StaticResource Label_ColorDiff}" />
            </ComboBox>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="5"
                        Visibility="{Binding Path=FilterMethod, 
                Converter={StaticResource FilterMethodToVisibleConverter}, ConverterParameter=0}">
                <TextBox VerticalAlignment="Center" Height="20" ToolTip="{StaticResource Tip_PleaseEnterName}"
                         Text="{Binding Path=Filter.Name}"/>
            </StackPanel>
            <Grid Grid.Column="3" VerticalAlignment="Center" Margin="5"
                  Visibility="{Binding Path=FilterMethod,
                Converter={StaticResource FilterMethodToVisibleConverter}, ConverterParameter=1}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DatePicker Text="{Binding Path=Filter.DateBegin}" ToolTip="{StaticResource Tip_BeginDate}"/>
                <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" Margin="5"/>
                <DatePicker Grid.Column="2" Text="{Binding Path=Filter.DateEnd}" ToolTip="{StaticResource Tip_EndDate}" />
            </Grid>
            <Grid Grid.Column="3" Visibility="{Binding Path=FilterMethod,
                Converter={StaticResource FilterMethodToVisibleConverter}, ConverterParameter=2}" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="L*:" Style="{StaticResource FormTextBlockStyle}"/> 
                <TextBox Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" MinWidth="50"
                         Text="{Binding Path=Filter.L, StringFormat=F2}"/>
                <TextBlock Grid.Column="2" Text="a*:" Style="{StaticResource FormTextBlockStyle}"/>
                <TextBox Grid.Column="3" Style="{StaticResource FormTextBoxStyle}" MinWidth="50"
                         Text="{Binding Path=Filter.a, StringFormat=F2}"/>
                <TextBlock Grid.Column="4" Text="b*:" Style="{StaticResource FormTextBlockStyle}"/>
                <TextBox Grid.Column="5" Style="{StaticResource FormTextBoxStyle}" MinWidth="50"
                         Text="{Binding Path=Filter.b, StringFormat=F2}"/>
                <TextBlock Grid.Column="6" Text="&#x0394;E:" Style="{StaticResource FormTextBlockStyle}"/>
                <TextBox Grid.Column="7" Style="{StaticResource FormTextBoxStyle}" MinWidth="50"
                         Text="{Binding Path=Filter.DE, StringFormat=F2}"/>
            </Grid>
            <Button Grid.Column="4" Style="{StaticResource ButtonStyle}"
                    Click="OnSearch" Content="{StaticResource Label_Search}"/>
        </Grid>
        <ui:SpecimenDataGrid Grid.Column="2" Grid.Row="1" 
                             x:Name="SpecimenDataGrid">
            <ui:SpecimenDataGrid.ContextMenu>
                <ContextMenu>
                    <ContextMenu.Items>
                        <MenuItem Command="{StaticResource RenameSelStandards}" />
                        <MenuItem Command="{StaticResource ModifyStandards}" />
                        <MenuItem Command="{StaticResource DelSelStandards}" />
                    </ContextMenu.Items>
                </ContextMenu>
            </ui:SpecimenDataGrid.ContextMenu>
        </ui:SpecimenDataGrid>
    </Grid>
</Window>



