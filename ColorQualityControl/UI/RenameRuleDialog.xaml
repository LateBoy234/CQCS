<Window x:Class="ThreeNH.ColorQualityControl.UI.RenameRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:UI="clr-namespace:ThreeNH.ColorQualityControl.UI"
        SizeToContent="WidthAndHeight"
        MaxHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="{StaticResource Title_AutoNamingRulesSetting}">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Visibility="{Binding ElementName=standardRenameRule, Path=Visibility}"
                   VerticalAlignment="Center" Text="{StaticResource Label_StandardNamingRulesColon}" />
        <UI:RenameRuleControl Grid.Row="0" Grid.Column="1" MaxHeight="30"
                              Margin="6" x:Name="standardRenameRule">
        </UI:RenameRuleControl>

        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Visibility="{Binding ElementName=testRenameRule, Path=Visibility}"
                   VerticalAlignment="Center" Text="{StaticResource Label_TestNamingRulesColon}" />
        <UI:RenameRuleControl Grid.Row="1" Grid.Column="1" MaxHeight="30"
                              Margin="6" x:Name="testRenameRule">
        </UI:RenameRuleControl>
        <TextBlock Grid.Row="2" Grid.Column="0"
                   VerticalAlignment="Center" Text="{StaticResource Label_MaterialColon}" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="6" Text="{Binding Material}" />
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6" >
            <Button Margin="0, 0, 10, 0" MinWidth="60" IsDefault="True" Click="OnOkClick" Content="{StaticResource Label_OK}" />
            <Button Margin="10, 0, 0, 0" MinWidth="60" IsCancel="True" Content="{StaticResource Label_Cancel}" />
        </StackPanel>
    </Grid>
</Window>
