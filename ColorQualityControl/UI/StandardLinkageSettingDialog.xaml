<mah:MetroWindow  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  x:Class="ThreeNH.ColorQualityControl.UI.StandardLinkageSettingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource Title_StandardLinkageSetting}"
        ShowCloseButton="False"
        ShowMaxRestoreButton="False"
        ShowMinButton="False"
        WindowStartupLocation="CenterOwner" MinWidth="300"
        SizeToContent="WidthAndHeight">
    <StackPanel>
        <StackPanel>
            <GroupBox Margin="6" Header="{StaticResource Label_LinkToStandard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto "/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="6, 6, 3, 6" VerticalAlignment="Center" Text="{StaticResource Label_StandardColon}" />
                    <ComboBox Grid.Column="1" Margin="3, 6, 6, 6" MinWidth="200"
                                  ItemsSource="{Binding Path=Standards}"
                                  SelectedValuePath="Specimen"
                                  SelectedValue="{Binding Path=SelectedStandard}"
                                  IsEnabled="{Binding Path=IsLinkToStandard}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Rectangle Grid.Column="0" Width="16" Height="16" Margin="0, 0, 3, 0" VerticalAlignment="Center"
                                                   Fill="{Binding Path=PseudoColor}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Path=Name}" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </GroupBox>
            <CheckBox  Margin="6" IsChecked="{Binding Path=DontLinkToStandard}" Content="{StaticResource Label_DontLinkToStandard}" />

        </StackPanel>
        <StackPanel Grid.Row="2" Margin="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="6" MinWidth="60" Click="OnOkClick" Content="{StaticResource Label_OK}" />
            <Button Margin="6" MinWidth="60" IsCancel="True" Content="{StaticResource Label_Cancel}" />
        </StackPanel>
    </StackPanel>
</mah:MetroWindow>
