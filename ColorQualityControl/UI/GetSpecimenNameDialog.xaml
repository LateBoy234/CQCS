<Window x:Class="ThreeNH.ColorQualityControl.UI.GetSpecimenNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
        Title="{StaticResource Title_InputSpecimenName}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0, 0, 6, 10"
                   VerticalAlignment="Center"
                   Text="{StaticResource Label_NameColon}" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0, 0, 0, 10" Width="250"
                 Name="txtboxName"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0, 10, 6, 10"
                   VerticalAlignment="Center"
                   Text="{StaticResource Label_MaterialColon}"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0, 10, 0, 10" Width="250"
                 Name="txtboxMaterial"/>
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0, 12, 0, 0">
            <Button MinWidth="60" Margin="0, 0, 10, 0" Content="{StaticResource Label_OK}"
                    IsDefault="True" Click="OnOkClick" />
            <Button MinWidth="60" Margin="10, 0, 0, 0" Content="{StaticResource Label_Cancel}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
