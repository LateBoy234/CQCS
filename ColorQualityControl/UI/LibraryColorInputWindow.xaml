<Window x:Class="ThreeNH.ColorQualityControl.UI.LibraryColorInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
        xmlns:controls="clr-namespace:ThreeNH.Controls"
        xmlns:converters="clr-namespace:ThreeNH.ColorQualityControl.Converters"
        mc:Ignorable="d"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="{StaticResource Title_LibraryColorInput}" SizeToContent="WidthAndHeight">
    <Window.Resources>
        <converters:BoolConverter x:Key="BoolConverter" />
    </Window.Resources>
    <Grid Margin="10">
       <Grid.RowDefinitions>
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
       </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
       <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Button Style="{StaticResource ButtonStyle}" 
                    Content="{StaticResource Label_Measure}"
                    Click="MeasureButton_OnClick"
                    IsEnabled="{Binding IsConnected}"
                    IsDefault="True"/>
            <Button Style="{StaticResource ButtonStyle}" 
                    Content="{StaticResource Label_Input}"
                    
                    Click="InputButton_OnClick"/>
            <Button Style="{StaticResource ButtonStyle}"
                    Content="{StaticResource Store}"
                    Click="Update_OnClick"
                    IsEnabled="{Binding DataRow, Converter={StaticResource BoolConverter}}"/>
            <Button Style="{StaticResource ButtonStyle}"
                    Content="{StaticResource Label_Delete}"
                    Click="Delete_OnClick"
                    IsEnabled="{Binding DataRow, Converter={StaticResource BoolConverter}}"/>
            <Button Style="{StaticResource ButtonStyle}" 
                    Content="{StaticResource Label_Search}"
                    Click="Search_OnClick"/>

            <Button Style="{StaticResource ButtonStyle}"
                   Content="{StaticResource Label_Clear}"
                    Click="ClearInputs_Click"/>

            <Separator />

            <TextBlock Style="{StaticResource FormTextBlockStyle}" 
                       Text="{StaticResource Label_LibraryColon}"/>
            <ComboBox Style="{StaticResource FormComboBoxStyle}" 
                      ItemsSource="{Binding LibraryNames}"
                      SelectedItem="{Binding CurrentLibrary}"
                      SelectionChanged="Libraries_OnSelectionChanged"/>
        </StackPanel>
       <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" 
                       Style="{StaticResource FormTextBlockStyle}"
                       Text="{StaticResource Label_NumberColon}"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     x:Name="NumberTextBox"
                     Style="{StaticResource FormTextBoxStyle}" 
                     Width="150"
                     Text="{Binding DataRow[Number]}"/>
            
            <TextBlock Grid.Row="1" Grid.Column="0" 
                       Style="{StaticResource FormTextBlockStyle}"
                       Text="{StaticResource Label_RemarkColon}"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     x:Name="RemarkTextBox"
                     Style="{StaticResource FormTextBoxStyle}" 
                     Width="150"
                     Text="{Binding DataRow[Remark]}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" 
                       Style="{StaticResource FormTextBlockStyle}"
                       Text="{StaticResource Label_MaterialColon}"/>
            <ComboBox Grid.Row="2" Grid.Column="1"
                      x:Name="MaterialComboBox"
                      IsEditable="True"
                      Style="{StaticResource FormComboBoxStyle}" 
                      Width="150"
                      ItemsSource="{Binding Materials}"
                      Text="{Binding DataRow[Material]}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" 
                       Style="{StaticResource FormTextBlockStyle}"
                       Text="{StaticResource Label_DateTimeColon}"/>
            <TextBox Grid.Row="3" Grid.Column="1"
                     x:Name="DateTimeTextBlock"
                     Style="{StaticResource FormTextBoxStyle}" 
                     Width="150"
                     Text="{Binding DataRow[DateTime]}"/>

            <GroupBox Grid.Row="0" Grid.Column="2" Grid.RowSpan="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" MinWidth="100" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource FormTextBlockStyle}" 
                               Text="L*:"/>

                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource FormTextBlockStyle}" 
                               Text="{Binding DataRow[L], StringFormat=F2}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource FormTextBlockStyle}" 
                               Text="a*:"/>

                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Style="{StaticResource FormTextBlockStyle}" 
                               Text="{Binding DataRow[a], StringFormat=F2}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Style="{StaticResource FormTextBlockStyle}" 
                               Text="b*:"/>

                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Style="{StaticResource FormTextBlockStyle}" 
                               Text="{Binding DataRow[b], StringFormat=F2}"/>
                </Grid>
            </GroupBox>

            <TextBlock Grid.Row="4" Grid.Column="0"
                       Style="{StaticResource FormTextBlockStyle}"
                       Text="{StaticResource Label_ColorFormulaColon}" />
            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                     x:Name="ColorFormulaTextBox"
                     Margin="3"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     MinWidth="200"
                     MinHeight="200"
                     Text="{Binding DataRow[ColorFormula]}"/>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="{StaticResource PseudoColor}"
                      x:Name="PseudoColorGroupBox"
                      Margin="5">
                <Rectangle MinWidth="100" Height="80" Margin="5"
                           Fill="{Binding SampleColor}" />
            </GroupBox>

            <GroupBox Grid.Row="1" Header="{StaticResource Label_SpectrumDiagram}"
                      x:Name="SpectrumPlotGroupBox"
                      Margin="5">
                <controls:SpectrumPlotControl x:Name="SpectrumPlotControl"
                                              Margin="5"
                                              MinWidth="300"
                                              MinHeight="200"
                                              MinReflectance="0" MaxReflectance="120"/>
            </GroupBox>
        </Grid>

        <CheckBox Grid.Row="2" Grid.Column="0" Margin="5"
                  Content="{StaticResource Label_AutoClearAfterStored}"
                  IsChecked="{Binding Path=AutoClearAfterStored}"/>
    </Grid>
</Window>
