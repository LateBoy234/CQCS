<Window x:Class="ThreeNH.ColorQualityControl.UI.ImportLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="{StaticResource Title_ImportLibrary}" Height="200" Width="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormTextBlockStyle}" -->
        <!--            Text="{StaticResource Label_NameColon}"/> -->
        <!-- <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormComboBoxStyle}" -->
        <!--           IsEditable="{Binding Path=CanAddLibrary}" ItemsSource="{Binding Path=LibraryNames}" -->
        <!--           Text="{Binding Path=LibraryName}" /> -->
        <!--        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource ButtonStyle}" />-->
        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormTextBlockStyle}"
                   Text="{StaticResource Label_MaterialColon}"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Path=Materials}"
                  SelectedIndex="{Binding Path=SelectedMaterial}"/>
        
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Style="{StaticResource ButtonStyle}" IsDefault="True"  Content="{StaticResource Label_Import}"
                    Click="OnClickImport"/>
            <Button Style="{StaticResource ButtonStyle}" IsCancel="True" Content="{StaticResource Label_Cancel}" />
        </StackPanel>
    </Grid>
</Window>
