<Window x:Class="ThreeNH.ColorQualityControl.UI.HazeMeasurementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
        mc:Ignorable="d"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="HazeMeasurementDialog" Height="300" Width="420">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" x:Name="_panel" HorizontalAlignment="Stretch"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ButtonStyle}"
                    Visibility="{Binding Path=MeasureRefBtnVisibility}"
                    x:Name="btnRef"
                    Click="MeasureRef_OnClick"
                    Content="{StaticResource Label_MeasureHazeReference}"/>
            <Button Style="{StaticResource ButtonStyle}" IsCancel="True" x:Name="btnCancel"
                    Content="{StaticResource Label_Cancel}"/>
        </StackPanel>
    </Grid>
</Window>
