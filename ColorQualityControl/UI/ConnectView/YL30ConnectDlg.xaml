<Window x:Class="ThreeNH.ColorQualityControl.UI.YL30ConnectDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
        mc:Ignorable="d"
        Width="400"
        MaxHeight="500"
        WindowStartupLocation="CenterScreen"
        Title="{StaticResource s_ConnectionSetting}">
    <Window.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="DataContext"
                Value="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin=" 5 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition  Width="Auto"/>
                <ColumnDefinition  Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource s_SelectCommType}" FontSize="15" Margin="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <ComboBox Name="cb_connetionType" SelectedItem="{Binding SelectedCommType}" Grid.Column="1" Margin="10"/>
        </Grid>
        <Grid Grid.Row="1" Margin=" 5 10"  x:Name="slaveIDPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="SlaveID" Grid.Row="0" FontSize="15" Margin="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                <TextBox  Text="{Binding SlaveID, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="80" Margin="5" FontSize="15"/>
                <TextBlock  Text="{StaticResource s_SlaveIDReminding}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" Foreground="red"/>
            </StackPanel>
        </Grid>
        <ContentControl  Content="{Binding SelectedCommType}" Grid.Row="2" >
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Grid Margin="10" Visibility="Collapsed" x:Name="NetworkPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="7*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="IP" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBox  Text="{Binding DataContext.IP,RelativeSource={RelativeSource AncestorType=Window}}"  Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="200" Margin="5" FontSize="15"/>
                            <TextBlock Text="Port" Grid.Row="1" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBox  Text="{Binding DataContext.Port,RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="200"  Margin="5" FontSize="15"/>
                            <!--<mah:ProgressRing Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"  Grid.ColumnSpan="2" IsLarge="False" Width="30" Height="30"  IsActive="{Binding IsConnecting}" />-->
                        </Grid>
                        <Grid Margin="10" Visibility="Collapsed" x:Name="SerialPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="7*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource s_SerialPort}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ComboBox   mah:TextBoxHelper.Watermark="{DynamicResource s_InsertInstrument}"  ItemsSource="{Binding SerialPortList}"  SelectedItem="{Binding DataContext.SerialComPort,RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="200" Margin="5 10"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource s_BaudRate}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ComboBox  Grid.Row="1" ItemsSource="{Binding BaudRateList}" SelectedItem="{Binding DataContext.BaudRate,RelativeSource={RelativeSource AncestorType=Window},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="200" Margin="5 10"/>
                            <TextBlock Text="{DynamicResource s_DataBit}" Grid.Row="2" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ComboBox  ItemsSource="{Binding DataBitList}" SelectedItem="{Binding DataContext.DataBits,RelativeSource={RelativeSource AncestorType=Window},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="200" Margin="5 10"/>
                            <TextBlock  Text="{DynamicResource s_Parity}" Grid.Row="3" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ComboBox  ItemsSource="{Binding ParityList}" SelectedItem="{Binding DataContext.Parity,RelativeSource={RelativeSource AncestorType=Window},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="200"  Margin="5 10"/>
                            <TextBlock  Text="{DynamicResource s_StopBit}" Grid.Row="4" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ComboBox  ItemsSource="{Binding StopBitList}" SelectedItem="{Binding DataContext.StopBit,RelativeSource={RelativeSource AncestorType=Window},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="200"  Margin="5 10"/>

                        </Grid>
                    </StackPanel>


                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding}" Value="Modbus TCP/IP">
                            <Setter TargetName="NetworkPanel" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}" Value="Socket">
                            <Setter TargetName="NetworkPanel" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <!--<DataTrigger Binding="{Binding}" Value="RS485">
                            <Setter TargetName="SerialPanel" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}" Value="RS232">
                            <Setter TargetName="SerialPanel" Property="Visibility" Value="Visible"/>
                        </DataTrigger>-->
                        <DataTrigger Binding="{Binding}" Value="USB">
                            <Setter TargetName="SerialPanel" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ContentControl.ContentTemplate>

        </ContentControl>
        <UniformGrid Grid.Row="3"  Rows="1"  Margin="0,0 0 10" HorizontalAlignment="Right">
            <Button Margin="10,5" Click="btOK_Click" MinWidth="120">
                <StackPanel Orientation="Horizontal">
                    <TextBlock 
               Margin="5,3"
              VerticalAlignment="Center"
             Text="{StaticResource Label_OK}" />
                </StackPanel>
            </Button>
            <Button Margin="10,5" IsCancel="True" Click="btCancle_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock

                      Margin="5,3"
                      VerticalAlignment="Center"
                      Text="{StaticResource  Label_Cancel}" />
                </StackPanel>
            </Button>
        </UniformGrid>
       
    </Grid>
</Window>
