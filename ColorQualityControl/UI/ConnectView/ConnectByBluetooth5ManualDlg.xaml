<Window
    x:Class="ThreeNH.ColorQualityControl.UI.ConnectByBluetooth5ManualDlg"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{StaticResource s_SearchBluetoothDevice}"
    WindowStartupLocation="CenterOwner"
    Width="600"
    Height="450"
    mc:Ignorable="d">
    <Window.Resources>
        <!-- 居中显示的单元格模板样式 -->
        <DataTemplate x:Key="CenteredCellTemplate">
            <TextBlock Text="{Binding}" 
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <TextBlock
                Margin="3"
                VerticalAlignment="Center"
                Text="{StaticResource s_Ports}" />
            <ComboBox
                x:Name="cbbSerialPorts"
                Width="150"
                Margin="3"
                IsReadOnly="True" VerticalContentAlignment="Center"/>
            <Button
                x:Name="btnStart"
                Margin="3"
                Click="StartSearch">
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="20"
                        Height="20"
                        Margin="3"
                        Source="..\Images\search_glyph.png" />
                    <TextBlock
                        Margin="3"
                        VerticalAlignment="Center"
                        Text="{StaticResource StartSearch}" />
                </StackPanel>
            </Button>
            <Button
                x:Name="btnStop"
                Margin="3"
                Click="StopSearch">
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="20"
                        Height="20"
                        Margin="3"
                        Source="..\Images\stop.jpg" />
                    <TextBlock
                        Margin="3"
                        VerticalAlignment="Center"
                        Text="{StaticResource StopSearch}" />
                </StackPanel>
            </Button>
            <Button
                x:Name="btnConnect"
                MinWidth="100"
                Margin="3"
                Click="ConnectToSlaveDevice">
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="20"
                        Height="20"
                        Margin="3"
                        Source="..\Images\fail.png" />
                    <TextBlock
                        Margin="3"
                        VerticalAlignment="Center"
                        Text="{StaticResource MenuItem_Connect}" />
                </StackPanel>
            </Button>
        </StackPanel>
        <Separator Grid.Row="1" Margin="0,3" />
        <ListView
            x:Name="deviceList"
            Grid.Row="2"
            SelectionChanged="devicelist_SelectionChanged"
            MouseDoubleClick="deviceList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn DisplayMemberBinding="{Binding Index}" CellTemplate="{StaticResource CenteredCellTemplate}" Header="{StaticResource Index}" Width="50"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Name}" CellTemplate="{StaticResource CenteredCellTemplate}" Header="{StaticResource Name}" Width="200"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Address}" CellTemplate="{StaticResource CenteredCellTemplate}" Header="{StaticResource DeviceAddress}" Width="150"/>
                        <GridViewColumn DisplayMemberBinding="{Binding SignalIntensity}" CellTemplate="{StaticResource CenteredCellTemplate}" Header="{StaticResource SignalIntensity}" Width="100"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
        <Grid Grid.Row="3" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image Source="../Images/Plus.png" Style="{StaticResource ToolButtonImageStyle}" Width="12" Height="12"/>
                <TextBlock Grid.Row="0" Text="{StaticResource BlueboothAutoConnectConfig}" FontSize="12" FontWeight="Bold"  Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" >
                <Image Source="../Images/success.png" Style="{StaticResource ToolButtonImageStyle}" Width="12" Height="12"/>
                <TextBlock Grid.Row="1" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0">
          <Run Text="{StaticResource SN}"/>
              <Run Text=":"/>
                </TextBlock>
                <TextBlock Grid.Row="1" Text="{Binding DeviceName}" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Red"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"  VerticalAlignment="Center" Grid.Row="2">
                <Image Source="../Images/success.png" Style="{StaticResource ToolButtonImageStyle}" Width="12" Height="12"/>
                <CheckBox FontSize="12"  
                  Content="{StaticResource  AutoConnectbyBluebooth }"
                  Click="ckIsAutoConnect_Click"
                  IsChecked="{Binding IsAutoConnectBth}"
                  VerticalContentAlignment="Center"  HorizontalContentAlignment="Left" 
                  VerticalAlignment="Center" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal"  VerticalAlignment="Center"  Visibility="Collapsed">
                <Image Source="../Images/success.png" Style="{StaticResource ToolButtonImageStyle}" Width="12" Height="12"/>
                <CheckBox FontSize="12" Grid.Row="3"
                  Content="{StaticResource  ConnectotherAvailableDeviceIfDefaultNotExist }"
                  IsChecked="{Binding IsAutoConnectOtherInstrument}"
                  VerticalContentAlignment="Center"  HorizontalContentAlignment="Left" 
                  VerticalAlignment="Center" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
