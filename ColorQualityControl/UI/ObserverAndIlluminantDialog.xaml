<Window x:Class="ThreeNH.ColorQualityControl.UI.ObserverAndIlluminantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl"
        xmlns:myctrl="clr-namespace:ThreeNH.Controls"
        Title="{StaticResource Title_IlluminantAndObserverSetting}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MinWidth="250">
    <StackPanel>
        <GroupBox Header="{StaticResource Label_Observer}" Margin="6"
                  Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <RadioButton Name="Degree2" Margin="6" GroupName="observer">
                    2&#x00B0; (CIE 1931)
                </RadioButton>
                <RadioButton Name="Degree10" Margin="24,6,6,6" GroupName="observer"
                             IsChecked="True">
                    10&#x00B0; (CIE 1964)
                </RadioButton>
            </StackPanel>
        </GroupBox>
        <Grid>
            <!-- <Grid.ColumnDefinitions> -->
            <!--     <ColumnDefinition Width="*" /> -->
            <!--     <ColumnDefinition Width="*" /> -->
            <!--     <ColumnDefinition Width="*" /> -->
            <!-- </Grid.ColumnDefinitions> -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Margin="6" Padding="5" MinWidth="100"
                      Header="{StaticResource Label_Primary}" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormTextBlockStyle}"
                               Text="{StaticResource Label_IlluminantColon}" />
                    <ComboBox 
                        Grid.Row="0" Grid.Column="1" Style="{StaticResource FormComboBoxStyle}"
                        Name="PrimaryIlluminant"  />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormTextBlockStyle}"
                               Text="{StaticResource Label_ObserverColon}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormComboBoxStyle}"
                              Name="PrimaryObserver"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="1" Margin="6" Padding="5" MinWidth="100"
                      Header="{StaticResource Label_Secondary}" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormTextBlockStyle}"
                               Text="{StaticResource Label_IlluminantColon}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormComboBoxStyle}"
                              Name="SecondaryIlluminant"  SelectionChanged="SecondaryIlluminant_SelectionChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormTextBlockStyle}"
                               Text="{StaticResource Label_ObserverColon}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormComboBoxStyle}"
                              Name="SecondaryObserver" SelectionChanged="SecondaryIlluminant_SelectionChanged"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="2" Margin="6" Padding="5" MinWidth="100"
                      Header="{StaticResource Label_Tertiary}" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormTextBlockStyle}"
                               Text="{StaticResource Label_IlluminantColon}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormComboBoxStyle}"
                              Name="TertiaryIlluminant"  SelectionChanged="TertiaryIlluminant_SelectionChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormTextBlockStyle}"
                               Text="{StaticResource Label_ObserverColon}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormComboBoxStyle}"
                              Name="TertiaryObserver" SelectionChanged="TertiaryIlluminant_SelectionChanged"/>
                </Grid>
            </GroupBox>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button MinWidth="60" Margin="6" IsDefault="True" Click="OkClick" Content="{StaticResource Label_OK}" />
            <Button IsCancel="True" MinWidth="60" Margin="6" Content="{StaticResource Label_Cancel}" />
        </StackPanel>
    </StackPanel>
</Window>
