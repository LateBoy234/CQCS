<Page
    x:Class="ThreeNH.ColorQualityControl.UI.CalibrationResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CalibrationResultPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="_booleanToVisibilityConverter" />
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>
        <Image
            x:Name="img"
            Grid.Row="1"
            Grid.Column="0"
            Width="35"
            Height="35"
            Margin="10"
            Source="{Binding Image}" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="1"
            Margin="5,0,50,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontSize="20"
            Text="{Binding Msg}"
            TextWrapping="Wrap" />
        <StackPanel
            Grid.Row="2"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                x:Name="btnBack"
                Width="80"
                Height="35"
                Margin="10"
                Command="{Binding BackCommand}"
                Content="{StaticResource Label_Back}"
                Visibility="{Binding BackButtonVisibility, Converter={StaticResource _booleanToVisibilityConverter}}" />
            <Button
                x:Name="btnClose"
                Width="80"
                Height="35"
                Margin="10"
                Command="{Binding CloseCommand}"
                Content="{StaticResource Label_Close}" />
        </StackPanel>
    </Grid>
</Page>
