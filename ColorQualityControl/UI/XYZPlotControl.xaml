<UserControl
    x:Class="ThreeNH.ColorQualityControl.UI.XYZPlotControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    MinWidth="260"
    MinHeight="200">

    <Grid Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180*" />
            <ColumnDefinition Width="80*" />
        </Grid.ColumnDefinitions>


        <lvc:CartesianChart
            Name="xyChart"
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            DisableAnimations="True"
            VisualElements="{Binding VisualElements}">
            <lvc:CartesianChart.AxisX>
                <lvc:Axis
                    Name="axisX"
                    Title="{Binding Path=XAxisTitle}"
                    MaxValue="2.0"
                    MinValue="-2.0">
                    <lvc:Axis.Sections>
                        <lvc:AxisSection
                            Stroke="Black"
                            StrokeThickness="1"
                            Value="0" />
                    </lvc:Axis.Sections>
                    <lvc:Axis.Separator>
                        <lvc:Separator Step="{Binding XStep}" />
                    </lvc:Axis.Separator>
                </lvc:Axis>
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:Axis
                    Name="axisY"
                    Title="{Binding Path=YAxisTitle}"
                    MaxValue="2.0"
                    MinValue="-2.0">
                    <lvc:Axis.Sections>
                        <lvc:AxisSection
                            Stroke="Black"
                            StrokeThickness="1"
                            Value="0" />
                    </lvc:Axis.Sections>
                    <lvc:Axis.Separator>
                        <lvc:Separator Step="{Binding YStep}" />
                    </lvc:Axis.Separator>
                </lvc:Axis>
            </lvc:CartesianChart.AxisY>
            <lvc:CartesianChart.Series>
                <lvc:ScatterSeries Values="{Binding Values}" />
            </lvc:CartesianChart.Series>
        </lvc:CartesianChart>


        <lvc:CartesianChart
            Name="zChart"
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            DisableAnimations="True">
            <lvc:CartesianChart.AxisX>
                <lvc:Axis
                    MaxValue="0.5"
                    MinValue="-0.5"
                    Position="LeftBottom"
                    ShowLabels="False">
                    <lvc:Axis.Sections>
                        <lvc:AxisSection
                            Stroke="Black"
                            StrokeThickness="1"
                            Value="0" />
                    </lvc:Axis.Sections>
                </lvc:Axis>
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:Axis
                    Name="axisZ"
                    Title="{Binding Path=ZAxisTitle}"
                    MaxValue="2"
                    MinValue="-2">
                    <lvc:Axis.Separator>
                        <lvc:Separator Step="{Binding ZStep}" />
                    </lvc:Axis.Separator>
                </lvc:Axis>
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>
    </Grid>
</UserControl>
