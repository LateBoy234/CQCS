<Window
    x:Class="ThreeNH.ColorQualityControl.UI.ColourAtla.PanTongMatch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:myctrls="clr-namespace:ThreeNH.Controls"
    Title="{DynamicResource BestMatchWindowLilin}"
    Width="1000"
    Height="700"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style x:Key="TolLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="1,3,1,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DeltaEStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TolStackPanelStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="6" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Margin" Value="6" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  存样库及直接色库检索  -->
        <GroupBox
            Grid.Row="0"
            Grid.Column="0"
            Header="{DynamicResource Label_LibraryOptionsKeySearchLilin}">
            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    Margin="5"
                    ItemsSource="{Binding ColourAtlaCollections}"
                    SelectedItem="{Binding ColourAtlaCollection}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="3,5"
                                VerticalAlignment="Center"
                                Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button
                    Grid.Column="1"
                    Height="30"
                    Panel.ZIndex="10"
                    Click="OnKeyWordSearchClicked"
                    Content="{DynamicResource Btn_KeySearchPanTongLibraryLilin}"
                    Style="{StaticResource ButtonStyle}" />
            </Grid>
        </GroupBox>
        <GridSplitter
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch" />
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  要查找的样品  -->
            <GroupBox Header="{DynamicResource Label_SamplingLilin}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource TolLabelStyle}"
                        Text="{DynamicResource Label_NameColon}" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding SampleList}"
                        MaxDropDownHeight="60"
                        SelectedIndex="{Binding CurrentSampleIndex}"
                        SelectedItem="{Binding CurrentSampleName}"
                        SelectionChanged="OnSelectSampleItem"
                        Style="{StaticResource FormComboBoxStyle}" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        Height="22"
                        Margin="6,6,6,0"
                        VerticalAlignment="Top"
                        Click="MeasureButton_OnClick"
                        Content="{DynamicResource Label_Measure}"
                        IsDefault="True"
                        Style="{StaticResource ButtonStyle}" />
                    <mah:ProgressRing
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        IsActive="{Binding IsProgressRingActiveLilin}"
                        IsLarge="True"
                        ToolTip="{DynamicResource Measuring}" />
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TolLabelStyle}" Text="L*" />
                        <TextBox
                            Width="72"
                            Height="20"
                            Text="{Binding Path=Lab_L, StringFormat=F2}" />
                        <TextBlock Style="{StaticResource TolLabelStyle}" Text="a*" />
                        <TextBox
                            Width="72"
                            Height="20"
                            Text="{Binding Path=Lab_a, StringFormat=F2}" />
                        <TextBlock Style="{StaticResource TolLabelStyle}" Text="b*" />
                        <TextBox
                            Width="72"
                            Height="20"
                            Text="{Binding Path=Lab_b, StringFormat=F2}" />

                    </StackPanel>
                    <Button
                        Grid.Row="2"
                        Grid.Column="2"
                        Height="22"
                        Margin="6,6,6,0"
                        VerticalAlignment="Top"
                        Click="OnSearchClick"
                        Content="{DynamicResource Label_Search}"
                        Style="{StaticResource ButtonStyle}" />
                </Grid>
            </GroupBox>
            <!--  过滤条件  -->
            <GroupBox Grid.Row="1" Header="{DynamicResource Label_SearchFilterLilin}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource TolLabelStyle}"
                        Text="{DynamicResource Label_SpecularComponentColon}" />
                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{Binding SpecularComponentList}"
                        SelectedItem="{Binding CurrentSpecCom}"
                        Style="{StaticResource FormComboBoxStyle}" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource TolLabelStyle}"
                        Text="{DynamicResource Label_IlluminantColon}" />
                    <ComboBox
                        Grid.Column="3"
                        ItemsSource="{Binding IlluminantList}"
                        SelectedItem="{Binding CurrentIllum}"
                        SelectionChanged="OnIlluminantChanged"
                        Style="{StaticResource FormComboBoxStyle}" />
                    <TextBlock
                        Grid.Column="4"
                        Style="{StaticResource TolLabelStyle}"
                        Text="{DynamicResource Label_ObserverColon}" />
                    <ComboBox
                        Grid.Column="5"
                        ItemsSource="{Binding ObserverList}"
                        SelectedItem="{Binding CurrentObser}"
                        SelectionChanged="OnObserverChanged"
                        Style="{StaticResource FormComboBoxStyle}" />

                    <TextBlock
                        Grid.Column="6"
                        Style="{StaticResource TolLabelStyle}"
                        Text="{DynamicResource Label_SortConditionLilin}" />
                    <ComboBox
                        Name="FilterComboBox"
                        Grid.Column="7"
                        ItemsSource="{Binding FilterList}"
                        SelectedItem="{Binding CurrentFilter}"
                        Style="{StaticResource FormComboBoxStyle}" />
                </Grid>
            </GroupBox>
            <!--  查找结果  -->
            <GroupBox Grid.Row="2" Header="{DynamicResource Label_SearchResultLilin}">
                <DataGrid
                    x:Name="ResultsDataGrid"
                    MinWidth="500"
                    AutoGenerateColumns="True"
                    Focusable="True"
                    IsReadOnly="True"
                    ItemsSource="{Binding DataTableLilin,Mode=OneWay}"
                    Sorting="ResultsDataGrid_Sorting"
                    SelectionChanged="OnSelectionChanged">
                    <DataGrid.InputBindings>
                        <KeyBinding
                            Command="{Binding SetMatchToCurrentStandard}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            Gesture="Ctrl+M" />
                    </DataGrid.InputBindings>

                    <DataGrid.ContextMenu>
                        <ContextMenu ItemsSource="{Binding ContextMenuItemsLilin}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}, Path=PlacementTarget}" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>

                        </ContextMenu>
                    </DataGrid.ContextMenu>


                </DataGrid>
            </GroupBox>
        </Grid>
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="0"
                MinWidth="200"
                HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="3"
                    HorizontalAlignment="Center"
                    Text="{DynamicResource Label_TargetColor}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="3"
                    HorizontalAlignment="Center"
                    Text="{DynamicResource Label_MatchedBestColorLilin}" />
                <Rectangle
                    Grid.Row="1"
                    Grid.Column="0"
                    Width="80"
                    Height="50"
                    Margin="3"
                    Fill="{Binding TargetColor}" />
                <Rectangle
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="80"
                    Height="50"
                    Margin="3"
                    Fill="{Binding MatchedBestSampleColor}" />
            </Grid>
            <GroupBox Grid.Row="1" Header="{DynamicResource Label_ColorDifFormulaLilin}">
                <TextBox
                    Height="100"
                    Margin="5"
                    IsReadOnly="True"
                    Text="{Binding CurrentFormula, Mode=OneWay}" />
            </GroupBox>
            <GroupBox Grid.Row="2" Header="{StaticResource Label_ChromaticDiagram}">
                <ContentControl x:Name="ToleranceChartView" MinHeight="200" />
            </GroupBox>
            <GroupBox Grid.Row="3" Header="{StaticResource Label_SpectrumDiagram}">
                <myctrls:SpectrumPlotControl
                    x:Name="SpectrumPlotControl"
                    Margin="6"
                    IsFillSeries="True"
                    MaxReflectance="120"
                    MinReflectance="0" />
            </GroupBox>
        </Grid>

    </Grid>

</Window>
