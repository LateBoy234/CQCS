<Window x:Class="ThreeNH.ColorQualityControl.UI.ChromaticitySettingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
        xmlns:data="clr-namespace:ThreeNH.DataModel;assembly=DataModel"
        xmlns:myctrls="clr-namespace:ThreeNH.Controls"
        WindowStartupLocation="CenterOwner"
        Title="{DynamicResource Title_DisplaySetting}"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight">
    <Window.Resources>
        <local:ChromaticityFieldConverter x:Key="converter" />
        <DataTemplate x:Key="ChromaticityListBoxTemplate">
            <TextBlock Text="{Binding Converter={StaticResource converter}}" />
        </DataTemplate>
    </Window.Resources>
    <StackPanel Margin="6">
        <GroupBox Header="{DynamicResource Label_Preset}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Margin="6" Header="{DynamicResource Label_ColorSpace}">
                    <myctrls:ColorSpaceComboBox WithNone="True" x:Name="ColorSpaceComboBox"
                                               Margin="6" SelectionChanged="ColorSpaceSelectionChanged"/>
                </GroupBox>
                <GroupBox Grid.Column="1" Margin="6" Header="{DynamicResource Label_ColorDiffFormula}">
                    <myctrls:ColorDiffFormulaComboBox Margin="6" 
                                                     x:Name="DiffFormulaComboBox"
                                                     SelectionChanged="DiffFormulaSelectionChanged"/>
                </GroupBox>
            </Grid>
        </GroupBox>
        <GroupBox Header="{DynamicResource Label_DataItemList}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Margin="6" Padding="6"
                          Header="{StaticResource Label_AvailableItems}">
                    <TabControl Height="300" MinWidth="250" MaxWidth="400"
                            TabStripPlacement="Left"
                            SelectionChanged="OnLeftTabControlSelectionChanged">
                        <TabItem Header="{DynamicResource Label_AllDataItems}" Padding="5">
                            <ListBox ItemTemplate="{StaticResource ChromaticityListBoxTemplate}"
                                 Name="LeftAttributeList" SelectionMode="Extended"
                                 SelectionChanged="OnLeftListBoxSelectionChanged"/>
                        </TabItem>
                        <TabItem Header="{DynamicResource Label_SampleAttributes}" Padding="5">
                            <ListBox ItemTemplate="{StaticResource ChromaticityListBoxTemplate}"
                                 Name="LeftSpecimenAttributesList" SelectionMode="Extended"
                                 SelectionChanged="OnLeftListBoxSelectionChanged" />
                        </TabItem>
                        <TabItem Header="{DynamicResource Label_ChormaticAttributes}" Padding="5">
                            <ListBox ItemTemplate="{StaticResource ChromaticityListBoxTemplate}"
                                 Name="LeftColorList" SelectionMode="Extended"
                                 SelectionChanged="OnLeftListBoxSelectionChanged"/>
                        </TabItem>
                        <TabItem Header="{DynamicResource Label_ColorDiffAttributes}" Padding="5">
                            <ListBox ItemTemplate="{StaticResource ChromaticityListBoxTemplate}"
                                 Name="LeftDiffList" SelectionMode="Extended"
                                 SelectionChanged="OnLeftListBoxSelectionChanged" />
                        </TabItem>
                        <TabItem Header="{DynamicResource Label_Reflectance}" Padding="5">
                            <ListBox ItemTemplate="{StaticResource ChromaticityListBoxTemplate}"
                                 Name="LeftReflectanceList" SelectionMode="Extended"
                                 SelectionChanged="OnLeftListBoxSelectionChanged" />
                        </TabItem>
                        <TabItem Header="{DynamicResource Label_ColorIndexes}" Padding="5">
                            <ListBox ItemTemplate="{StaticResource ChromaticityListBoxTemplate}"
                                 Name="LeftIndexList" SelectionMode="Extended" />
                        </TabItem>
                        <TabItem Header="{DynamicResource Label_ColorIndexesDiff}" Padding="5">
                            <ListBox ItemTemplate="{StaticResource ChromaticityListBoxTemplate}"
                                 Name="LeftIndexDiffList" SelectionMode="Extended" />
                        </TabItem>
                        <TabItem Header="K/S" Padding="5">
                            <ListBox ItemTemplate="{StaticResource ChromaticityListBoxTemplate}"
                                 Name="LeftAbsoluteStrengthList" SelectionMode="Extended" />
                        </TabItem>
                        <TabItem Header="{DynamicResource Label_Absorbance}" Padding="5">
                            <ListBox ItemTemplate="{StaticResource ChromaticityListBoxTemplate}"
                                 Name="LeftAbsorbanceList" SelectionMode="Extended" />
                        </TabItem>
                        <TabItem Header="{DynamicResource Label_ChP}" Padding="5">
                            <ListBox ItemTemplate="{StaticResource ChromaticityListBoxTemplate}"
                                 Name="LeftChPList" SelectionMode="Extended" />
                        </TabItem>

                        <TabItem Header="{DynamicResource Label_EUP}" Padding="5">
                            <ListBox ItemTemplate="{StaticResource ChromaticityListBoxTemplate}"
                                  Name="LeftEUPList" SelectionMode="Extended" />
                        </TabItem>
                        <TabItem Header="{DynamicResource Label_USP}" Padding="5">
                            <ListBox ItemTemplate="{StaticResource ChromaticityListBoxTemplate}"
                                  Name="LeftUSAPList" SelectionMode="Extended" />
                        </TabItem>
                    </TabControl>
                </GroupBox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button MinWidth="60" Margin="6" Click="MoveToRightClick"
                            IsEnabled="{Binding CanMoveToRight}"
                            Content="&gt;&gt;"/>
                    <Button MinWidth="60" Margin="6" Click="MoveToLeftClick"
                            IsEnabled="{Binding ElementName=RightAttributeList, Path=SelectedItems.Count}"
                            Content="&lt;&lt;" />
                    <Button MinWidth="60" Margin="6" Click="RemoveAllClick"
                            IsEnabled="{Binding ElementName=RightAttributeList, Path=Items.Count}"
                            Content="{DynamicResource Label_RemoveAll}" />
                </StackPanel>
                <GroupBox Grid.Column="2" Margin="6" Padding="6" Header="{DynamicResource Label_DisplayedItems}" >
                    <ListBox Width="150" MinHeight="150" MaxHeight="300"
                             ItemTemplate="{StaticResource ChromaticityListBoxTemplate}"
                             Name="RightAttributeList"  SelectionMode="Extended">
                    </ListBox>
                </GroupBox>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <Button Margin="6" Click="TopClick" MinWidth="40"
                            IsEnabled="{Binding ElementName=RightAttributeList, Path=SelectedItems.Count}"
                            Content="{DynamicResource Label_MoveToTop}"/>
                    <Button Margin="6" Click="UpClick" MinWidth="40"
                            IsEnabled="{Binding ElementName=RightAttributeList, Path=SelectedItems.Count}"
                            Content="{DynamicResource Label_MoveUp}"/>
                    <Button Margin="6" Click="DownClick" MinWidth="40"
                            IsEnabled="{Binding ElementName=RightAttributeList, Path=SelectedItems.Count}"
                            Content="{DynamicResource Label_MoveDown}"/>
                    <Button Margin="6" Click="BottomClick" MinWidth="40"
                            IsEnabled="{Binding ElementName=RightAttributeList, Path=SelectedItems.Count}"
                            Content="{DynamicResource Label_MoveToBottom}"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Margin="10, 6, 10, 6" MinWidth="60" IsDefault="True" Click="OkClick" Content="{DynamicResource Label_OK}" />
            <Button Margin="10, 6, 10, 6" MinWidth="60" IsCancel="True" Content="{DynamicResource Label_Cancel}"/>
            <Button Margin="10, 6, 10, 6" MinWidth="60" IsEnabled="{Binding Path=IsModified}"
                    Click="RestoreButtonClick" Content="{DynamicResource Label_Restore}" />
        </StackPanel>
    </StackPanel>
</Window>
