<Window
    x:Class="ThreeNH.ColorQualityControl.UI.SelectBlueToothDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="400"
    Height="280"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="Itemstyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <StackPanel
                            x:Name="sp"
                            Margin="5"
                            Orientation="Horizontal">
                            <Image
                                Width="18"
                                Height="18"
                                Source="../Images/serialport.png" />
                            <Label Content="{Binding Index}" FontSize="12" />
                            <Label Content="{Binding Name}" FontSize="12" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="sp" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0.5,0.22" EndPoint="0.5,1">
                                            <GradientStop Offset="0.31" Color="#1F2BCCAA" />
                                            <GradientStop Offset="0.88" Color="Gray" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Control.MouseDoubleClick" Handler="ListViewItemDoubleClick" />
        </Style>
    </Window.Resources>
    <Window.Title>
        <StaticResource ResourceKey="Title_SelectABlueToothDevice" />
    </Window.Title>
    <StackPanel>
        <ListView
            x:Name="SelectBlueToothDeviceListView"
            Height="200"
            ItemContainerStyle="{StaticResource Itemstyle}"
            ItemsSource="{Binding BlueToothDevices}"
            SelectedItem="{Binding CurrentBlueToothDevice}" />
        <StackPanel
            Margin="10"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="btnOK"
                MinWidth="60"
                Margin="10,6,10,6"
                Click="OkClick"
                Content="{DynamicResource Label_OK}"
                IsDefault="True" />
            <Button
                x:Name="btnCancel"
                MinWidth="60"
                Margin="10,6,10,6"
                Click="cancelClick"
                Content="{DynamicResource Label_Cancel}"
                IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
