<Window
    x:Class="ThreeNH.ColorQualityControl.UI.InstrumentDataManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ThreeNH.ColorQualityControl"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:myctrls="clr-namespace:ThreeNH.Controls"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="clr-namespace:ThreeNH.ColorQualityControl.UI"
    Title="{DynamicResource Title_InstrumentDataManagement}"
    Width="600"
    Height="480"
    Loaded="OnLoaded"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <RoutedUICommand x:Key="ImportSelectedStandard" Text="{StaticResource MenuItem_ImportSelectedStandards}" />
        <RoutedUICommand x:Key="ImportSelectedStandardWithTests" Text="{StaticResource MenuItem_ImportSelectedStandardsWithTests}" />
        <RoutedUICommand x:Key="ImportAllStandards" Text="{StaticResource MenuItem_ImportAllStandards}" />
        <RoutedUICommand x:Key="ImportAllStandardsWithTests" Text="{StaticResource MenuItem_ImportAllStandardsWithTests}" />
        <RoutedUICommand x:Key="ExportSelectedStandard" Text="{StaticResource MenuItem_ExportSelectedStandards}" />
        <RoutedUICommand x:Key="ExportSelectedStandardWithTests" Text="{StaticResource MenuItem_ExportSelectedStandardsWithTests}" />
        <RoutedUICommand x:Key="ExportAllStandards" Text="{StaticResource MenuItem_ExportAllStandards}" />
        <RoutedUICommand x:Key="ExportAllStandardsWithTests" Text="{StaticResource MenuItem_ExportAllStandardsWithTests}" />
        <RoutedUICommand x:Key="DeleteAllStandards" Text="{StaticResource MenuItem_DeleteAllSamples}" />
        <RoutedUICommand x:Key="DeleteSelectedSamples" Text="{StaticResource MenuItem_DeleteSelectedSamples}" />
        <RoutedUICommand x:Key="ImportSelectedTest" Text="{StaticResource MenuItem_ImportSelectedTests}" />
        <RoutedUICommand x:Key="ImportAllTests" Text="{StaticResource MenuItem_ImportAllTests}" />
        <RoutedUICommand x:Key="ExportSelectedTest" Text="{StaticResource MenuItem_ExportSelectedTests}" />
        <RoutedUICommand x:Key="ExportAllTests" Text="{StaticResource MenuItem_ExportAllTests}" />
        <RoutedUICommand x:Key="DeleteAllTests" Text="{StaticResource MenuItem_DeleteAllTests}" />
        <RoutedUICommand x:Key="DeleteSelectedStandards" Text="{StaticResource MenuItem_DeleteSelectedStandards}" />
        <RoutedUICommand x:Key="DeleteTestsInList" Text="{StaticResource MenuItem_DeleteTestsInList}" />
        <!--<RoutedUICommand x:Key="UploadAllSpecimens" Text="{StaticResource MenuItem_UploadAllSamples}" />-->
        <RoutedCommand x:Key="StopUploading" />

        <ContextMenu x:Key="TreeViewContextMenu">
            <MenuItem Command="{StaticResource ImportSelectedStandard}" />
            <MenuItem Command="{StaticResource ImportSelectedStandardWithTests}" />
            <MenuItem Command="{StaticResource ImportAllStandards}" />
            <MenuItem Command="{StaticResource ImportAllStandardsWithTests}" />
            <Separator />
            <MenuItem Command="{StaticResource ExportSelectedStandard}" />
            <MenuItem Command="{StaticResource ExportSelectedStandardWithTests}" />
            <MenuItem Command="{StaticResource ExportAllStandards}" />
            <MenuItem Command="{StaticResource ExportAllStandardsWithTests}" />
            <Separator />
            <MenuItem Command="{StaticResource DeleteSelectedStandards}" />
            <MenuItem Command="{StaticResource DeleteAllStandards}" />
            <MenuItem Command="{StaticResource DeleteSelectedSamples}" />
            <MenuItem Command="{StaticResource DeleteAllTests}" />
            <Separator />
            <!--<MenuItem Command="{StaticResource UploadAllSpecimens}" />-->
        </ContextMenu>

        <ContextMenu x:Key="StandardDataContextMenu">
            <MenuItem Command="{StaticResource ImportSelectedStandard}" />
            <MenuItem Command="{StaticResource ImportSelectedStandardWithTests}" />
            <MenuItem Command="{StaticResource ImportAllStandards}" />
            <MenuItem Command="{StaticResource ImportAllStandardsWithTests}" />
            <Separator />
            <MenuItem Command="{StaticResource ExportSelectedStandard}" />
            <MenuItem Command="{StaticResource ExportSelectedStandardWithTests}" />
            <MenuItem Command="{StaticResource ExportAllStandards}" />
            <MenuItem Command="{StaticResource ExportAllStandardsWithTests}" />
            <Separator />
            <MenuItem Command="{StaticResource DeleteSelectedStandards}" />
            <MenuItem Command="{StaticResource DeleteAllStandards}" />
            <MenuItem Command="{StaticResource DeleteSelectedSamples}" />
            <MenuItem Command="{StaticResource DeleteAllTests}" />
        </ContextMenu>

        <ContextMenu x:Key="TestDataContextMenu">
            <MenuItem Command="{StaticResource ImportSelectedTest}" />
            <MenuItem Command="{StaticResource ImportAllTests}" />
            <Separator />
            <MenuItem Command="{StaticResource ExportSelectedTest}" />
            <MenuItem Command="{StaticResource ExportAllTests}" />
            <Separator />
            <MenuItem Command="{StaticResource DeleteTestsInList}" />
        </ContextMenu>

        <ui:ObjectVisibleConverter x:Key="visibleConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{StaticResource StopUploading}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding
            CanExecute="ImportSelectedStandardCanExecute"
            Command="{StaticResource ImportSelectedStandard}"
            Executed="OnImportSelectedStandardExecuted" />
        <CommandBinding
            CanExecute="ImportSelectedStandardCanExecute"
            Command="{StaticResource ImportSelectedStandardWithTests}"
            Executed="OnImportSelectedStandardWithTestsExecuted" />
        <CommandBinding
            CanExecute="ImportAllStandardsCanExecute"
            Command="{StaticResource ImportAllStandards}"
            Executed="OnImportAllStandardsExecuted" />
        <CommandBinding
            CanExecute="ImportAllStandardsCanExecute"
            Command="{StaticResource ImportAllStandardsWithTests}"
            Executed="OnImportAllStandardsWidthTestsExecuted" />
        <CommandBinding
            CanExecute="ImportSelectedStandardCanExecute"
            Command="{StaticResource ExportSelectedStandard}"
            Executed="OnExportSelectedStandardExecuted" />
        <CommandBinding
            CanExecute="ImportSelectedStandardCanExecute"
            Command="{StaticResource ExportSelectedStandardWithTests}"
            Executed="OnExportSelectedStandardWithTestsExecuted" />
        <CommandBinding
            CanExecute="ImportAllStandardsCanExecute"
            Command="{StaticResource ExportAllStandards}"
            Executed="OnExportAllStandardsExecuted" />
        <CommandBinding
            CanExecute="ImportAllStandardsCanExecute"
            Command="{StaticResource ExportAllStandardsWithTests}"
            Executed="OnExportAllStandardsWidthTestsExecuted" />
        <CommandBinding
            CanExecute="ImportAllStandardsCanExecute"
            Command="{StaticResource DeleteAllStandards}"
            Executed="OnDeleteAllStandardsExecuted" />
        <CommandBinding
            CanExecute="DeleteSelectedTestsCanExecuted"
            Command="{StaticResource DeleteSelectedSamples}"
            Executed="OnDeleteSelectedTestsExecuted" />
        <CommandBinding
            CanExecute="DeleteAllTestsCanExecuted"
            Command="{StaticResource DeleteAllTests}"
            Executed="OnDeleteAllTestsExecuted" />
        <CommandBinding
            CanExecute="CanDeleteSelectedStandards"
            Command="{StaticResource DeleteSelectedStandards}"
            Executed="OnDeleteSelectedStandards" />

        <CommandBinding
            CanExecute="ImportSelectedTestCanExecute"
            Command="{StaticResource ImportSelectedTest}"
            Executed="OnImportSelectedTestExecuted" />
        <CommandBinding
            CanExecute="ImportAllTestsCanExecute"
            Command="{StaticResource ImportAllTests}"
            Executed="OnImportAllTestsExecuted" />
        <CommandBinding
            CanExecute="ImportSelectedTestCanExecute"
            Command="{StaticResource ExportSelectedTest}"
            Executed="OnExportSelectedTestExecuted" />
        <CommandBinding
            CanExecute="ImportAllTestsCanExecute"
            Command="{StaticResource ExportAllTests}"
            Executed="OnExportAllTestsExecuted" />
        <CommandBinding
            CanExecute="ImportAllTestsCanExecute"
            Command="{StaticResource DeleteTestsInList}"
            Executed="OnDeleteTestsInListExecuted" />

        <!--<CommandBinding Command="{StaticResource UploadAllSpecimens}" Executed="UploadAllSpecimensExecuted" />-->

        <CommandBinding Command="{StaticResource StopUploading}" Executed="OnStopUpload" />

    </Window.CommandBindings>
    <DockPanel Margin="10">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <Button Click="OnDisplaySettingClick" Content="{StaticResource Label_DisplaySetting}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <myctrls:ObserverComboBox Observer="CIE1964" SelectionChanged="ObserverComboBox_SelectionChanged" />
            </StatusBarItem>
            <StatusBarItem>
                <myctrls:IlluminantComboBox Illuminant="D65" SelectionChanged="IlluminantComboBox_SelectionChanged" />
            </StatusBarItem>
            <StatusBarItem>
                <myctrls:SpecularComponentComboBox
                    x:Name="SpecularComponentComboBox"
                    IsEnabled="{Binding CanSwitchSpecularComponent}"
                    SelectionChanged="SpecularComponentComboBox_SelectionChanged"
                    SpecularComponent="SCIAndSCE"
                    WithNone="True" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Text="{Binding UploadingStatus}" />
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal" />

            <TreeView
                Name="SpecimenTreeView"
                Grid.Row="1"
                Grid.Column="0"
                ContextMenu="{StaticResource TreeViewContextMenu}"
                SelectedItemChanged="SpecimenTreeView_SelectedItemChanged">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type ui:StandardDataItem}" ItemsSource="{Binding Path=Tests}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                            <Rectangle
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                Margin="0,1,2,1"
                                VerticalAlignment="Center"
                                Fill="{Binding Path=SCI.PseudoColorBrush}"
                                Visibility="{Binding SCI, Converter={StaticResource visibleConverter}}" />
                            <Rectangle
                                Grid.Column="2"
                                Width="16"
                                Height="16"
                                Margin="2,1,2,1"
                                VerticalAlignment="Center"
                                Fill="{Binding Path=SCE.PseudoColorBrush}"
                                Visibility="{Binding SCE, Converter={StaticResource visibleConverter}}" />
                            <Rectangle
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                Margin="2,1,2,1"
                                VerticalAlignment="Center"
                                Fill="{Binding Path=Clr.PseudoColorBrush}"
                                Visibility="{Binding Clr, Converter={StaticResource visibleConverter}}" />
                            <TextBlock
                                Grid.Column="3"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Text="{Binding Path=ID, StringFormat=D4}" />
                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Text="{Binding Path=Name}" />
                        </Grid>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type ui:SampleDataItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                IsChecked="{Binding IsChecked}" />
                            <Rectangle
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                Margin="0,1,2,1"
                                VerticalAlignment="Center"
                                Fill="{Binding Path=SCI.PseudoColorBrush}"
                                Visibility="{Binding SCI, Converter={StaticResource visibleConverter}}" />
                            <Rectangle
                                Grid.Column="2"
                                Width="16"
                                Height="16"
                                Margin="2,1,2,1"
                                VerticalAlignment="Center"
                                Fill="{Binding Path=SCE.PseudoColorBrush}"
                                Visibility="{Binding SCE, Converter={StaticResource visibleConverter}}" />
                            <Rectangle
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                Margin="2,1,2,1"
                                VerticalAlignment="Center"
                                Fill="{Binding Path=Clr.PseudoColorBrush}"
                                Visibility="{Binding Clr, Converter={StaticResource visibleConverter}}" />
                            <TextBlock
                                Grid.Column="3"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Text="{Binding Path=ID, StringFormat=D4}" />
                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Text="{Binding Path=Name}" />
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
                <TreeViewItem
                    Name="RootTreeItem"
                    Header="Standard"
                    IsExpanded="True" />
            </TreeView>

            <GridSplitter
                Grid.Row="1"
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch" />

            <ui:SpecimenDataGrid
                x:Name="SpecimenDataGrid"
                Grid.Row="1"
                Grid.Column="2" />
        </Grid>
    </DockPanel>

</Window>
