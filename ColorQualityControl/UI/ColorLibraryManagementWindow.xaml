<Window x:Class="ThreeNH.ColorQualityControl.UI.ColorLibraryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreeNH.ColorQualityControl.UI"
        xmlns:controls="clr-namespace:ThreeNH.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:converters="clr-namespace:ThreeNH.ColorQualityControl.Converters"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="{StaticResource Title_LibraryManagement}" Height="560" Width="1024">
   <Window.Resources>
        <converters:ObserverConverter x:Key="ObserverConverter" />
        <converters:IlluminantConverter x:Key="IlluminantConverter" />
        <converters:LabToPseudoColorConverter x:Key="LabToPseudoColorConverter" />

       <RoutedUICommand x:Key="AddLibrary" />
        <RoutedUICommand x:Key="ImportLibrary" />
        <RoutedUICommand x:Key="DelLibrary" />
        <RoutedUICommand x:Key="RenameLibrary" />
        <RoutedUICommand x:Key="DelSelStandards" Text="{StaticResource Label_DeleteSelectedSamples}" />
        <RoutedUICommand x:Key="RenameSelStandards" Text="{StaticResource MenuItem_Rename}" />
        <RoutedUICommand x:Key="ModifyStandards" Text="{StaticResource MenuItem_Modify}" />
        <RoutedUICommand x:Key="InputStandard" Text="{StaticResource MenuItem_InputStandard}"/>
        <RoutedUICommand x:Key="ImportIntoStandardList" Text="{StaticResource MenuItem_ImportToStandardList}" />
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{StaticResource AddLibrary}"
                        Executed="AddLibrary_Executed"/>
        <CommandBinding Command="{StaticResource ImportLibrary}"
                        Executed="ImportLibrary_Executed"
                        CanExecute="CanOperateOnLibrary"/>
        <CommandBinding Command="{StaticResource DelLibrary}"
                        Executed="DelLibrary_Executed"
                        CanExecute="CanOperateOnLibrary"/>
        <CommandBinding Command="{StaticResource RenameLibrary}"
                        Executed="RenameLibrary_Executed"
                        CanExecute="CanOperateOnLibrary"/>
        <CommandBinding Command="{StaticResource DelSelStandards}"
                        Executed="OnDeleteSelectedStandards"
                        CanExecute="CanDeleteStandardsExecute"/>
        <CommandBinding Command="{StaticResource ModifyStandards}"
                        Executed="OnModifyStandard"
                        CanExecute="CanRenameStandardExecute"/>
        <CommandBinding Command="{StaticResource InputStandard}" 
                        Executed="OnInputStandard"/>
        <CommandBinding Command="{StaticResource ImportIntoStandardList}" 
                        Executed="OnImportIntoStandardList"
                        CanExecute="CanImportIntoStandardList"/>
    </Window.CommandBindings>
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ToolBar HorizontalAlignment="Stretch" >
            <Button ToolTip="{StaticResource Tip_CreateNewLibrary}" Command="{StaticResource AddLibrary}">
                <Image  Style="{StaticResource ToolButtonImageStyle}"
                        Source="../Images/new_cab.png" Width="24" Height="24" />
            </Button>
            <Button ToolTip="{StaticResource Tip_ImportLibrary}" Command="{StaticResource ImportLibrary}">
                <Image Style="{StaticResource ToolButtonImageStyle}"
                       Source="../Images/import_cab.png" Width="24" Height="24"/>
            </Button>
            <Button ToolTip="{StaticResource Tip_DeleteLibrary}" Command="{StaticResource DelLibrary}">
                <Image  Style="{StaticResource ToolButtonImageStyle}"
                        Source="../Images/del_cab.png" Width="24" Height="24" />
            </Button>
            <Button ToolTip="{StaticResource Tip_RenameLibrary}" Command="{StaticResource RenameLibrary}">
                <Image  Style="{StaticResource ToolButtonImageStyle}"
                        Source="../Images/Rename.ico" Width="24" Height="24" />
            </Button>
        </ToolBar>
        <ToolBar Grid.Row="0" Grid.Column="2">
            <Label Content="{StaticResource Label_Number}"/>
            <TextBox x:Name="tbName" MinWidth="80" Text="{Binding QueryName,UpdateSourceTrigger=PropertyChanged}" >
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding QueryCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Label Content="{StaticResource Label_LibraryColon}"/>
            <ComboBox x:Name="cbbLibrary" ItemsSource="{Binding LibraryNames}" SelectedItem="{Binding CurrentLibraryName}" MinWidth="100"/>
            <Label Content="{StaticResource Tip_BeginDate}"/>
            <DatePicker Name="dpBegin" SelectedDate="{Binding BeginDate}"/>
            <Label Content="{StaticResource Tip_EndDate}"/>
            <DatePicker Name="dpEnd" SelectedDate="{Binding EndDate}"/>
            <Button x:Name="btnQuery" Margin="5,0,5,0" Command="{Binding QueryCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="../Images/search_glyph.png" Margin="3"/>
                    <TextBlock Text="{StaticResource Label_Search}" Margin="3"/>
                </StackPanel>
            </Button>
        </ToolBar>
        <ListBox Grid.Column="0" Grid.Row="1" 
                 ItemsSource="{Binding Path=LibraryNames}"
                 SelectedItem="{Binding Path=CurrentLibraryName}"
                 SelectionChanged="OnSelectedLibraryChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="../Images/cab.ico" Width="16" Height="16"
                               Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding}"></TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Stretch" 
                      HorizontalAlignment="Center" Width="5"/>
        <DataGrid Grid.Column="2" Grid.Row="1" 
                  x:Name="DataGrid"
                  ItemsSource="{Binding ColorsView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction 
                Command="{StaticResource ModifyStandards}"
                CommandParameter="{Binding SelectedItem}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <ContextMenu.Items>
                        <MenuItem Command="{StaticResource ModifyStandards}" />
                        <MenuItem Command="{StaticResource InputStandard}" />
                        <MenuItem Command="{StaticResource DelSelStandards}" />
                        <Separator />
                        <MenuItem Command="{StaticResource ImportIntoStandardList}" />
                    </ContextMenu.Items>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Header="{StaticResource Label_Index}" 
                                    Binding="{Binding Id}"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="{StaticResource Label_Number}" 
                                    Binding="{Binding Number}"/>
                <DataGridTemplateColumn Header="{StaticResource Label_PseudoColor}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Rectangle Margin="1" MinWidth="32">
                                <Rectangle.Fill>
                                    <MultiBinding Converter="{StaticResource LabToPseudoColorConverter}">
                                        <Binding Path="L" />
                                        <Binding Path="a" />
                                        <Binding Path="b" />
                                    </MultiBinding>
                                </Rectangle.Fill>
                            </Rectangle>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{StaticResource Label_Remark}" 
                                    Binding="{Binding Remark}"/>
                <DataGridTextColumn Header="{StaticResource Label_DateTime}"
                                    Binding="{Binding DateTime}"/>
                <DataGridTextColumn Header="{StaticResource InstrumentModel}"
                                    Binding="{Binding Instrument}"/>
                <DataGridTextColumn Header="{StaticResource MeasurementCondition}" 
                                    Binding="{Binding Condition}"/>
                <DataGridTextColumn Header="{StaticResource Label_StandardIlluminant}" 
                                    Binding="{Binding Illuminant, Converter={StaticResource IlluminantConverter}}"/>
                <DataGridTextColumn Header="{StaticResource Label_StandardObserver}" 
                                    Binding="{Binding Observer, Converter={StaticResource ObserverConverter}}"/>
                <DataGridTextColumn Header="L*" 
                                    Binding="{Binding L, StringFormat=F2}"/>
                <DataGridTextColumn Header="a*" 
                                    Binding="{Binding a, StringFormat=F2}"/>
                <DataGridTextColumn Header="b*" 
                                    Binding="{Binding b, StringFormat=F2}"/>
                <DataGridTextColumn Header="{StaticResource Label_ColorFormula}"
                                    Binding="{Binding ColorFormula}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
